{
  "schemaVersion": "harnessos.connector.v1",
  "id": "fams",
  "name": "FAMS Investment Management",
  "displayName": "FAMS 投资管理连接器",
  "version": "v2.2.0",
  "domainPack": "mcp/fams-domain-pack.json",
  "domainPackName": "fams",
  "domain": "financial_asset_management",
  "description": "Expose the FAMS three-stage investment workflow through official stdio and Streamable HTTP MCP transports; retain the REST bridge for compatibility only.",
  "connectors": [
    {
      "id": "fams_mcp_http",
      "type": "http_mcp",
      "status": "deprecated_compatibility_only",
      "recommendedReplacement": "fams_mcp_streamable_http",
      "warning": "This legacy REST bridge exposes the full registry and is not the canonical external workflow surface.",
      "baseUrl": "http://localhost:4000",
      "paths": {
        "domainPack": "/api/v1/mcp/domain-pack",
        "tools": "/api/v1/mcp/tools",
        "call": "/api/v1/mcp/call",
        "batch": "/api/v1/mcp/batch"
      },
      "context": {
        "userId": {
          "required": true,
          "sources": ["parameters.userId", "headers.x-fams-user-id", "headers.x-user-id"],
          "conflictPolicy": "fail_with_USER_CONTEXT_MISMATCH",
          "missingPolicy": "fail_with_USER_CONTEXT_REQUIRED"
        }
      }
    },
    {
      "id": "fams_mcp_stdio",
      "type": "stdio_mcp",
      "status": "ready",
      "command": "node",
      "args": ["backend/dist/mcp/stdio.js"],
      "sourceEntrypoint": "backend/src/mcp/stdio.ts",
      "configPath": "mcp/financial-mcp.json",
      "env": {
        "FAMS_MCP_DEFAULT_USER_ID": "default",
        "FAMS_MCP_PROFILE": "workflow"
      },
      "context": {
        "userId": {
          "required": false,
          "default": "default",
          "sources": ["FAMS_MCP_DEFAULT_USER_ID", "parameters.userId"],
          "conflictPolicy": "fail_with_USER_CONTEXT_MISMATCH",
          "missingPolicy": "inject_default_user"
        }
      }
    },
    {
      "id": "fams_mcp_streamable_http",
      "type": "streamable_http_mcp",
      "status": "ready",
      "endpoint": "http://127.0.0.1:4010/mcp",
      "loopbackOnly": true,
      "sourceEntrypoint": "backend/src/mcp/streamableHttp.ts",
      "env": {
        "FAMS_MCP_DEFAULT_USER_ID": "default",
        "FAMS_MCP_PROFILE": "workflow"
      },
      "context": {
        "userId": {
          "required": false,
          "default": "default",
          "conflictPolicy": "fail_with_USER_CONTEXT_MISMATCH"
        }
      }
    }
  ],
  "capabilities": {
    "toolDiscovery": true,
    "singleToolCall": true,
    "batchToolCall": true,
    "domainPackDiscovery": true,
    "asyncOperations": true,
    "artifactRefs": true,
    "nextActions": true,
    "humanConfirmation": true,
    "resources": true,
    "prompts": true,
    "streamableHttp": true
  },
  "toolContract": {
    "sourceOfTruth": "Official MCP tools/list for the workflow profile",
    "legacyRegistryDiscovery": "GET /api/v1/mcp/domain-pack",
    "toolsPath": "GET /api/v1/mcp/tools",
    "callEnvelope": "fams.mcp.call.v1",
    "batchEnvelope": "fams.mcp.batch.v1",
    "statuses": ["completed", "blocked", "failed"]
  },
  "safety": {
    "tradeProtection": "The workflow profile does not expose transaction or broker-order tools; all four trading capability flags remain false",
    "writePolicy": "writes_must_be_explicitly_scoped_to_user_context",
    "confirmationPolicy": "tools with requiresHumanConfirmation=true must return blocked status until confirmation is supplied",
    "workflowProfile": "basic_information_confirmation -> position_strategy -> backtest_review; account routing is tonghuashun to rotation/dividend and alipay to portfolio",
    "volatilityProfile": "broker order creation and strategy activation are not exposed; canCreateOrder=false and autoTradeUnlocked=false",
    "hostVision": "the host submits structured screenshot facts; the server does not invoke OCR or a vision model in the volatility profile"
  },
  "canonicalTools": [
    "investment_workflow.get_readiness",
    "investment_workflow.list_strategy_assignments",
    "investment_workflow.suggest_strategy_assignments",
    "investment_workflow.confirm_strategy_assignment",
    "investment_workflow.run_rotation_volatility_strategy",
    "investment_workflow.get_dividend_low_vol_plan",
    "investment_workflow.refresh_dividend_low_vol_research",
    "investment_workflow.get_portfolio_state",
    "investment_workflow.preflight_portfolio_review",
    "investment_workflow.start_portfolio_review",
    "investment_workflow.get_portfolio_review",
    "investment_workflow.compare_saved_advice_scenarios",
    "backtest.grid_replay.list_sources",
    "backtest.grid_replay.run",
    "backtest.grid_replay.get_result",
    "operation.get",
    "market_data.get_asset_trend",
    "capture.upload_screenshot",
    "capture.apply_extraction",
    "capture.get_preview",
    "capture.update_row",
    "capture.confirm_rows"
  ],
  "validation": {
    "httpSmoke": {
      "headers": { "x-fams-user-id": "default" },
      "tool": "investment_workflow.get_readiness",
      "expectedStatus": "completed"
    },
    "stdioSmoke": {
      "context": { "userId": "default" },
      "tool": "investment_workflow.get_readiness",
      "expectedStatus": "completed"
    },
    "tradeProtectionSmoke": {
      "tool": "investment_workflow.start_portfolio_review",
      "expectedStatusWithoutConfirmation": "blocked",
      "expectedCode": "HUMAN_CONFIRMATION_REQUIRED",
      "forbiddenTools": ["create_transaction", "grid_strategy.activate"]
    }
  }
}
