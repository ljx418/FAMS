{
  "schemaVersion": "harnessos.connector.v1",
  "id": "fams",
  "name": "FAMS Investment Management",
  "displayName": "FAMS 投资管理连接器",
  "version": "v2.1.0",
  "domainPack": "mcp/fams-domain-pack.json",
  "domainPackName": "fams",
  "domain": "financial_asset_management",
  "description": "Expose FAMS DomainPack tools to harnessOS through HTTP MCP and stdio MCP transports.",
  "connectors": [
    {
      "id": "fams_mcp_http",
      "type": "http_mcp",
      "status": "ready",
      "baseUrl": "http://localhost:4000",
      "paths": {
        "domainPack": "/api/v1/mcp/domain-pack",
        "tools": "/api/v1/mcp/tools",
        "call": "/api/v1/mcp/call",
        "batch": "/api/v1/mcp/batch"
      },
      "context": {
        "userId": {
          "required": true,
          "sources": ["parameters.userId", "headers.x-fams-user-id", "headers.x-user-id"],
          "conflictPolicy": "fail_with_USER_CONTEXT_MISMATCH",
          "missingPolicy": "fail_with_USER_CONTEXT_REQUIRED"
        }
      }
    },
    {
      "id": "fams_mcp_stdio",
      "type": "stdio_mcp",
      "status": "ready",
      "command": "node",
      "args": ["backend/dist/mcp/stdio.js"],
      "sourceEntrypoint": "backend/src/mcp/stdio.ts",
      "configPath": "mcp/financial-mcp.json",
      "env": {
        "FAMS_MCP_DEFAULT_USER_ID": "default",
        "FAMS_MCP_PROFILE": "full"
      },
      "context": {
        "userId": {
          "required": false,
          "default": "default",
          "sources": ["FAMS_MCP_DEFAULT_USER_ID", "parameters.userId"],
          "conflictPolicy": "fail_with_USER_CONTEXT_MISMATCH",
          "missingPolicy": "inject_default_user"
        }
      }
    },
    {
      "id": "fams_mcp_streamable_http",
      "type": "streamable_http_mcp",
      "status": "ready",
      "endpoint": "http://127.0.0.1:4010/mcp",
      "loopbackOnly": true,
      "sourceEntrypoint": "backend/src/mcp/streamableHttp.ts",
      "env": {
        "FAMS_MCP_DEFAULT_USER_ID": "default",
        "FAMS_MCP_PROFILE": "volatility"
      },
      "context": {
        "userId": {
          "required": false,
          "default": "default",
          "conflictPolicy": "fail_with_USER_CONTEXT_MISMATCH"
        }
      }
    }
  ],
  "capabilities": {
    "toolDiscovery": true,
    "singleToolCall": true,
    "batchToolCall": true,
    "domainPackDiscovery": true,
    "asyncOperations": true,
    "artifactRefs": true,
    "nextActions": true,
    "humanConfirmation": true,
    "resources": true,
    "prompts": true,
    "streamableHttp": true
  },
  "toolContract": {
    "sourceOfTruth": "GET /api/v1/mcp/domain-pack",
    "toolsPath": "GET /api/v1/mcp/tools",
    "callEnvelope": "fams.mcp.call.v1",
    "batchEnvelope": "fams.mcp.batch.v1",
    "statuses": ["completed", "blocked", "failed"]
  },
  "safety": {
    "tradeProtection": "transaction.* tools require human confirmation before writes",
    "writePolicy": "writes_must_be_explicitly_scoped_to_user_context",
    "confirmationPolicy": "tools with requiresHumanConfirmation=true must return blocked status until confirmation is supplied",
    "volatilityProfile": "broker order creation and strategy activation are not exposed; canCreateOrder=false and autoTradeUnlocked=false",
    "hostVision": "the host submits structured screenshot facts; the server does not invoke OCR or a vision model in the volatility profile"
  },
  "canonicalTools": [
    "volatility_workflow.reconcile",
    "volatility_workflow.run",
    "volatility_workflow.get_result",
    "market_data.get_real_time_price",
    "market_data.refresh_prices",
    "position.list",
    "portfolio.get_analysis",
    "portfolio.get_daily_snapshot",
    "advice.get_suggestions",
    "advice.generate_daily",
    "alert.list",
    "alert.check",
    "backtest.run_strategy",
    "backtest.run_from_advice",
    "operation.list",
    "operation.get",
    "operation.get_artifact",
    "transaction.create_manual_record",
    "market_data.get_asset_trend",
    "daily_review.run",
    "daily_review.get_latest",
    "daily_review.get",
    "daily_review.list",
    "grid_strategy.list_templates",
    "grid_strategy.create_draft",
    "grid_strategy.validate_draft",
    "grid_strategy.activate",
    "capture.upload_screenshot",
    "capture.apply_extraction",
    "capture.get_preview",
    "capture.vision_status",
    "capture.update_row",
    "capture.confirm_rows",
    "relative_rotation.get_industry_crowding",
    "relative_rotation.get_market_flow",
    "relative_rotation.refresh_industry_crowding",
    "relative_rotation.get_holdings_timeline",
    "relative_rotation.refresh_holdings_timeline",
    "relative_rotation.list_watchlist",
    "relative_rotation.add_watchlist_item",
    "relative_rotation.delete_watchlist_item",
    "relative_rotation.get_watchlist_timeline",
    "relative_rotation.refresh_watchlist_timeline",
    "relative_rotation.list_research_studies",
    "relative_rotation.create_research_study",
    "relative_rotation.update_research_study",
    "relative_rotation.delete_research_study",
    "relative_rotation.get_research_timeline",
    "relative_rotation.refresh_research_timeline"
  ],
  "validation": {
    "httpSmoke": {
      "headers": { "x-fams-user-id": "default" },
      "tool": "operation.list",
      "expectedStatus": "completed"
    },
    "stdioSmoke": {
      "context": { "userId": "default" },
      "tool": "operation.list",
      "expectedStatus": "completed"
    },
    "tradeProtectionSmoke": {
      "tool": "create_transaction",
      "expectedStatus": "blocked",
      "expectedCode": "HUMAN_CONFIRMATION_REQUIRED"
    }
  }
}
