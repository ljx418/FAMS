{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fams.local/schemas/fams-substage-acceptance-manifest.schema.json",
  "title": "FAMS Substage Acceptance Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "scope",
    "stages",
    "globalHardGates"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "fams.substage_acceptance_manifest.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object",
      "required": [
        "supportsControlledAutomation",
        "supportsUnattendedEndToEndAutomation",
        "supportsFormalTradingRelease"
      ],
      "additionalProperties": false,
      "properties": {
        "supportsControlledAutomation": { "const": true },
        "supportsUnattendedEndToEndAutomation": { "const": false },
        "supportsFormalTradingRelease": { "const": false }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/stage" }
    },
    "globalHardGates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": [
        "stageId",
        "purpose",
        "entryCriteria",
        "commands",
        "requiredArtifacts",
        "artifactSchemas",
        "automatedGates",
        "manualGates",
        "rollbackConditions",
        "exitCodePolicy"
      ],
      "additionalProperties": false,
      "properties": {
        "stageId": {
          "type": "string",
          "enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8"]
        },
        "purpose": { "type": "string", "minLength": 1 },
        "entryCriteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "requiredArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifactSchemas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "automatedGates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "manualGates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rollbackConditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exitCodePolicy": {
          "type": "object",
          "required": ["allCommandsMustExitZero", "blockedGateExitCode", "failedGateExitCode"],
          "additionalProperties": false,
          "properties": {
            "allCommandsMustExitZero": { "const": true },
            "blockedGateExitCode": { "type": "integer", "const": 2 },
            "failedGateExitCode": { "type": "integer", "const": 1 }
          }
        }
      }
    },
    "command": {
      "type": "object",
      "required": ["id", "command", "requiredBeforeExit"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "requiredBeforeExit": { "type": "boolean" }
      }
    }
  }
}

