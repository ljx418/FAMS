{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://px.local/schemas/v2-px-intent-route-v3.schema.json",
  "title": "V2-PX Intent Route Contract v3",
  "type": "object",
  "required": ["schemaVersion", "productId", "repository", "commitSha", "entryContainer", "entryAction", "routeIntent", "targetContainer", "routeId", "correlationId", "idempotencyKey", "permissionType", "routePayload", "audit"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "v2-px-intent-route/3" },
    "productId": { "const": "fams-v2-px" },
    "repository": { "const": "https://github.com/ljx418/FAMS.git" },
    "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "entryContainer": { "enum": ["sidepanel", "workspace_page", "host_app"] },
    "entryAction": { "enum": ["view_source", "open_workspace", "open_in_workspace"] },
    "routeIntent": { "enum": ["source_library", "source_detail", "ask", "trace", "graph"] },
    "targetContainer": { "enum": ["sidepanel", "workspace_page"] },
    "routeId": { "type": "string", "pattern": "^px-route-[a-z0-9][a-z0-9-]{7,80}$" },
    "correlationId": { "type": "string", "pattern": "^px-corr-[a-z0-9][a-z0-9-]{7,80}$" },
    "idempotencyKey": { "type": "string", "pattern": "^px-idem-[a-z0-9][a-z0-9-]{7,120}$" },
    "permissionType": { "enum": ["read_only_direct", "compute_quick_run", "confirm_before_operation", "permanently_blocked"] },
    "routePayload": { "type": "object" },
    "audit": {
      "type": "object",
      "required": ["createdAt", "sourceContainer", "schemaValidated", "semanticValidationRequired"],
      "additionalProperties": false,
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "sourceContainer": { "enum": ["sidepanel", "workspace_page", "host_app"] },
        "schemaValidated": { "const": true },
        "semanticValidationRequired": { "const": true }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "entryContainer": { "const": "sidepanel" } }, "required": ["entryContainer"] }, "then": { "properties": { "audit": { "type": "object", "properties": { "sourceContainer": { "const": "sidepanel" } } } } } },
    { "if": { "properties": { "entryContainer": { "const": "workspace_page" } }, "required": ["entryContainer"] }, "then": { "properties": { "audit": { "type": "object", "properties": { "sourceContainer": { "const": "workspace_page" } } } } } },
    { "if": { "properties": { "entryContainer": { "const": "host_app" } }, "required": ["entryContainer"] }, "then": { "properties": { "audit": { "type": "object", "properties": { "sourceContainer": { "const": "host_app" } } } } } },
    { "if": { "properties": { "entryAction": { "const": "view_source" }, "entryContainer": { "const": "sidepanel" } }, "required": ["entryAction", "entryContainer"] }, "then": { "properties": { "targetContainer": { "const": "sidepanel" } } } },
    { "if": { "properties": { "entryAction": { "const": "view_source" }, "entryContainer": { "enum": ["workspace_page", "host_app"] } }, "required": ["entryAction", "entryContainer"] }, "then": { "properties": { "targetContainer": { "const": "workspace_page" } } } },
    { "if": { "properties": { "entryAction": { "enum": ["open_workspace", "open_in_workspace"] } }, "required": ["entryAction"] }, "then": { "properties": { "targetContainer": { "const": "workspace_page" } } } },
    { "if": { "properties": { "routeIntent": { "const": "source_library" } }, "required": ["routeIntent"] }, "then": { "properties": { "routePayload": { "$ref": "#/$defs/sourceLibraryPayload" } } } },
    { "if": { "properties": { "routeIntent": { "const": "source_detail" } }, "required": ["routeIntent"] }, "then": { "properties": { "routePayload": { "$ref": "#/$defs/sourceDetailPayload" } } } },
    { "if": { "properties": { "routeIntent": { "const": "ask" } }, "required": ["routeIntent"] }, "then": { "properties": { "routePayload": { "$ref": "#/$defs/askPayload" } } } },
    { "if": { "properties": { "routeIntent": { "const": "trace" } }, "required": ["routeIntent"] }, "then": { "properties": { "routePayload": { "$ref": "#/$defs/tracePayload" } } } },
    { "if": { "properties": { "routeIntent": { "const": "graph" } }, "required": ["routeIntent"] }, "then": { "properties": { "routePayload": { "$ref": "#/$defs/graphPayload" } } } }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,80}$" },
    "sourceLibraryPayload": { "type": "object", "required": ["workspaceId"], "additionalProperties": false, "properties": { "workspaceId": { "$ref": "#/$defs/id" }, "filter": { "type": "string", "maxLength": 120 } } },
    "sourceDetailPayload": { "type": "object", "required": ["workspaceId", "sourceRef"], "additionalProperties": false, "properties": { "workspaceId": { "$ref": "#/$defs/id" }, "sourceRef": { "$ref": "#/$defs/id" } } },
    "askPayload": { "type": "object", "required": ["workspaceId"], "additionalProperties": false, "properties": { "workspaceId": { "$ref": "#/$defs/id" }, "conversationId": { "$ref": "#/$defs/id" } } },
    "tracePayload": { "type": "object", "required": ["workspaceId", "operationId"], "additionalProperties": false, "properties": { "workspaceId": { "$ref": "#/$defs/id" }, "operationId": { "$ref": "#/$defs/id" }, "sourceRef": { "$ref": "#/$defs/id" } } },
    "graphPayload": { "type": "object", "required": ["workspaceId", "graphScope", "graphId"], "additionalProperties": false, "properties": { "workspaceId": { "$ref": "#/$defs/id" }, "graphScope": { "enum": ["daily-review", "operation"] }, "graphId": { "$ref": "#/$defs/id" }, "focusNodeId": { "$ref": "#/$defs/id" } } }
  }
}
