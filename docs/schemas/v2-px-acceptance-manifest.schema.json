{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://px.local/schemas/v2-px-acceptance-manifest.schema.json",
  "title": "V2-PX Acceptance Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "repository",
    "commitSha",
    "routeAStatus",
    "pxStage",
    "gates",
    "artifacts",
    "antiFalseGreen"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "v2-px-acceptance-manifest/1"
    },
    "product": {
      "type": "object",
      "required": ["productId", "hostApplication", "extensionPackage"],
      "additionalProperties": false,
      "properties": {
        "productId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "hostApplication": {
          "type": "string",
          "minLength": 1
        },
        "extensionPackage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+(\\.git)?$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "routeAStatus": {
      "type": "string",
      "enum": ["proposed", "accepted"]
    },
    "pxStage": {
      "type": "string",
      "enum": ["PX-0", "PX-1", "PX-2", "PX-3", "PX-4", "PX-5", "PX-6"]
    },
    "gates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["gateId", "status", "evidenceRefs", "failureOwner"],
        "additionalProperties": false,
        "properties": {
          "gateId": {
            "type": "string",
            "enum": ["G1", "G2", "G3", "G4", "G5", "G6", "G7"]
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "blocked", "not_applicable"]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/artifactRef"
            }
          },
          "failureOwner": {
            "type": "string",
            "enum": ["PX-0", "PX-1", "PX-2", "PX-3", "PX-4", "PX-5", "PX-6", "none"]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "antiFalseGreen": {
      "type": "object",
      "required": [
        "staticMockHtmlUsed",
        "prototypeScreenshotOnly",
        "semanticValidatorPassed",
        "allArtifactHashesVerified"
      ],
      "additionalProperties": false,
      "properties": {
        "staticMockHtmlUsed": {
          "const": false
        },
        "prototypeScreenshotOnly": {
          "const": false
        },
        "semanticValidatorPassed": {
          "type": "boolean"
        },
        "allArtifactHashesVerified": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["path", "sha256", "artifactType"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifactType": {
          "type": "string",
          "enum": ["json", "html", "png", "trace", "log", "markdown"]
        }
      }
    }
  }
}

