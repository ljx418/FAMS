{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://px.local/schemas/v2-px-dual-container-lifecycle-v3.schema.json",
  "title": "V2-PX Dual Container Lifecycle Audit v3",
  "type": "object",
  "required": ["schemaVersion", "productId", "repository", "commitSha", "workspaceId", "routeId", "correlationId", "events", "derivedResult", "antiFalseGreen"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "v2-px-dual-container-lifecycle/3" },
    "productId": { "const": "fams-v2-px" },
    "repository": { "const": "https://github.com/ljx418/FAMS.git" },
    "commitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "workspaceId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,80}$" },
    "routeId": { "type": "string", "pattern": "^px-route-[a-z0-9][a-z0-9-]{7,80}$" },
    "correlationId": { "type": "string", "pattern": "^px-corr-[a-z0-9][a-z0-9-]{7,80}$" },
    "events": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/event" } },
    "derivedResult": { "type": "object", "required": ["state", "stateDerivedFromEvents", "recoverable"], "additionalProperties": false, "properties": { "state": { "$ref": "#/$defs/state" }, "stateDerivedFromEvents": { "const": true }, "recoverable": { "type": "boolean" }, "reasonCode": { "type": "string", "maxLength": 80 } } },
    "antiFalseGreen": { "type": "object", "required": ["staticMockHtmlUsed", "prototypeScreenshotOnly", "semanticValidatorRequired"], "additionalProperties": false, "properties": { "staticMockHtmlUsed": { "const": false }, "prototypeScreenshotOnly": { "const": false }, "semanticValidatorRequired": { "const": true } } }
  },
  "$defs": {
    "state": { "enum": ["uninitialized", "connecting", "ready", "loading", "empty", "failed", "disconnected", "recovering", "blocked", "closed"] },
    "event": {
      "type": "object",
      "required": ["schemaVersion", "eventId", "sequence", "workspaceId", "routeId", "correlationId", "container", "containerInstanceId", "eventType", "previousState", "nextState", "storageVersion", "at"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "v2-px-lifecycle-event/3" },
        "eventId": { "type": "string", "pattern": "^px-event-[a-z0-9-]{8,80}$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "workspaceId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,80}$" },
        "routeId": { "type": "string", "pattern": "^px-route-[a-z0-9][a-z0-9-]{7,80}$" },
        "correlationId": { "type": "string", "pattern": "^px-corr-[a-z0-9][a-z0-9-]{7,80}$" },
        "container": { "enum": ["sidepanel", "workspace_page", "background"] },
        "containerInstanceId": { "type": "string", "minLength": 3, "maxLength": 100 },
        "eventType": { "enum": ["start", "resume", "route_intent", "connected", "load_succeeded", "load_empty", "load_failed", "connection_lost", "reconnect", "state_migrated", "lease_expired", "storage_write_failed", "dispatch_result_unknown", "close", "blocked"] },
        "previousState": { "$ref": "#/$defs/state" },
        "nextState": { "$ref": "#/$defs/state" },
        "reasonCode": { "type": "string", "maxLength": 80 },
        "storageVersion": { "const": 1 },
        "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
