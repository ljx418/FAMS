        <mxCell id="01-draft" parent="1" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;" value="路径 C：人工计划草案&#xa;服务：portfolioBacktestReviewService&#xa;只输出 PLAN_DRAFT / MANUAL_TRADE_DRAFT。formalTargetWeight=0，canCreateOrder=false。" vertex="1">
          <mxGeometry height="170" width="430" x="890" y="350" as="geometry" />
