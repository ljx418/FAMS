        </mxCell>
        <mxCell id="p6_s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=0;spacing=8;align=left;verticalAlign=top;fillColor=#e6f6ec;strokeColor=#2f855a;fontColor=#17452e;strokeWidth=1;" value="路径 A：导入真实资产
下载模板 -&gt; 上传 -&gt; 预览错误 -&gt; 确认导入 -&gt; Dashboard 刷新 -&gt; 导出复核 -&gt; 进入组合回测。" vertex="1">
          <mxGeometry x="80" y="140" width="420" height="140" as="geometry" />
