  <diagram id="ftr-page-3" name="3 正式数据治理">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p3-title" value="FTR-1 正式 provider 与字段级数据治理" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p3-base" value="现有基础（已实现）&#xa;formalProviderIngestionService&#xa;marketDataFreshnessService&#xa;market_bar_canonical&#xa;market_tradeability_daily&#xa;DividendLowVolDaily" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#f3f4f6;strokeColor=#6b7280;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="330" height="250" as="geometry"/></mxCell>
        <mxCell id="p3-gap" value="当前缺口（真实 baseline）&#xa;部分 candidate providerClass=unknown&#xa;freshnessStatus=unknown&#xa;coverageStatus=blocked&#xa;分红 contribution 为研究估算&#xa;最新审计 asOfDate=2026-06-05&#xa;正式授权未确认" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="470" y="180" width="360" height="250" as="geometry"/></mxCell>
        <mxCell id="p3-provider" value="已实现 FormalDataProviderService（授权 gate blocked）&#xa;输入：candidate / 字段 / 日期 / 授权上下文&#xa;职责：provider adapter、授权状态、版本、secret 隔离&#xa;输出：FormalDataSnapshot" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="910" y="160" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="p3-policy" value="已实现 FormalDataFreshnessPolicy（业务证据待满足）&#xa;最近已完成交易日 + provider SLA&#xa;price / benchmark / tradeability 按交易日判断&#xa;dividend / fundamental 按公告周期判断" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="910" y="410" width="390" height="190" as="geometry"/></mxCell>
        <mxCell id="p3-validator" value="已实现 FieldEvidenceValidator（关键缺口不得伪绿）&#xa;关键域：price / benchmark / dividend / tradeability / fundamental / industry / costModel&#xa;逐 candidate 判定，不允许平均值掩盖失败项" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="910" y="640" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="p3-audit" value="审计产物（蓝）&#xa;15_data_governance_audit.json&#xa;provider_authorization_audit.json&#xa;field_evidence_validation_audit.json&#xa;字段必须含 provider / asOf / fetchedAt / freshness / coverage / crossCheck / evidenceRefs" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="1380" y="180" width="350" height="300" as="geometry"/></mxCell>
        <mxCell id="p3-user" value="用户体验&#xa;Backtest：按 candidate 查看字段可信状态和恢复动作&#xa;ChatBox：普通话解释为什么不能正式交易&#xa;Operations：打开同一 evidenceRefs&#xa;缺口不隐藏、不只显示 HTTP 错误" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="1380" y="550" width="350" height="250" as="geometry"/></mxCell>
        <mxCell id="p3-pass" value="FTR-1 出门&#xa;providerAuthorizationVerified=true&#xa;criticalFieldsHaveEvidenceRefs=true&#xa;noCriticalProviderUnknown=true&#xa;noCriticalFreshnessUnknownOrStale=true&#xa;noCriticalCoverageBlocked=true&#xa;formalDataGovernancePassed=true" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="380" height="260" as="geometry"/></mxCell>
        <mxCell id="p3-fail" value="Hard Fail / 打回 FTR-1&#xa;free_source 冒充 official&#xa;关键 evidenceRefs 为空仍 passed&#xa;stale/unknown 被隐藏&#xa;provider secret 进入日志或 artifact&#xa;任何交易权限=true" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="500" y="560" width="330" height="240" as="geometry"/></mxCell>
        <mxCell id="p3-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p3-base" target="p3-gap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p3-gap" target="p3-provider"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p3-provider" target="p3-policy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p3-policy" target="p3-validator"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p3-validator" target="p3-audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p3-audit" target="p3-user"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ftr-page-4" name="4 Benchmark 与总回报回测">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p4-title" value="FTR-2 官方/可信 Total-Return Benchmark 与回测关联" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p4-current" value="当前 portfolioBenchmarkService（已实现）&#xa;cash_cny = price_index&#xa;csi300_price_index = price_index&#xa;local_equal_weight_20 = research_proxy&#xa;free_source_total_return = free_source_total_return&#xa;可支持 formal review，不能支持 formal trading" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="400" height="280" as="geometry"/></mxCell>
        <mxCell id="p4-adapter" value="FormalBenchmarkService 已实现受控导入&#xa;OfficialTotalReturnBenchmarkAdapter&#xa;TrustedTotalReturnBenchmarkAdapter&#xa;授权数据/许可仍需人工外部输入&#xa;输出：版本化 total-return curve + sourceRefs" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="390" height="250" as="geometry"/></mxCell>
        <mxCell id="p4-qualification" value="Benchmark qualification 工程合同已实现，业务资格 blocked&#xa;规范枚举：official_total_return / trusted_total_return / free_source_total_return / price_index / research_proxy / unavailable&#xa;校验授权、覆盖率、日期、证据和 alias" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="1040" y="190" width="430" height="250" as="geometry"/></mxCell>
        <mxCell id="p4-engine" value="PortfolioBacktestEngine（保留计算）&#xa;使用同一 benchmark curve 计算：&#xa;benchmarkReturn / excessReturn&#xa;dividendContribution / capitalGainContribution&#xa;costDrag / equityCurve / drawdownCurve" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#f3f4f6;strokeColor=#6b7280;spacing=14;" vertex="1" parent="1"><mxGeometry x="560" y="540" width="390" height="260" as="geometry"/></mxCell>
        <mxCell id="p4-audit" value="审计证据&#xa;16_benchmark_qualification_audit.json&#xa;benchmark_license_review.json&#xa;benchmark_total_return_replay.json&#xa;图表、指标和表格必须来自同一 replay 结果" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="1040" y="540" width="430" height="250" as="geometry"/></mxCell>
        <mxCell id="p4-user" value="用户操作与体验&#xa;1. Backtest 选择 official/trusted benchmark&#xa;2. 运行 1年/3年/5年/自定义区间&#xa;3. 查看总回报、回撤、分红和成本&#xa;4. 免费源/price index 显示降级原因&#xa;5. Operations 打开授权与 replay 证据" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="400" height="280" as="geometry"/></mxCell>
        <mxCell id="p4-gate" value="FTR-2 出门门槛&#xa;benchmarkType=official_total_return 或 trusted_total_return&#xa;benchmarkAuthorizationReviewed=true&#xa;benchmarkSourceRefsPresent=true&#xa;deprecatedAliasesPersisted=false&#xa;researchProxyCannotPassFormalValidation=true&#xa;benchmarkQualificationPassed=true" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="1520" y="190" width="240" height="400" as="geometry"/></mxCell>
        <mxCell id="p4-hard" value="Hard Fail&#xa;free source 冒充 official&#xa;price index 写成 total return&#xa;无授权证据仍 passed&#xa;proxy 进入 formal pass" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="1520" y="650" width="240" height="210" as="geometry"/></mxCell>
        <mxCell id="p4-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p4-current" target="p4-adapter"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p4-adapter" target="p4-qualification"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6b7280;" edge="1" parent="1" source="p4-qualification" target="p4-engine"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p4-engine" target="p4-audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p4-audit" target="p4-gate"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ftr-page-5" name="5 Formal Validation">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p5-title" value="FTR-3 Release Candidate Formal Validation" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p5-baseline" value="当前基线（合同实现，业务不足）&#xa;PortfolioBacktestEngine.buildFormalValidationAudit&#xa;17_formal_validation_audit.json&#xa;strategyCount=7&#xa;passed=0 / warning=6 / insufficient=1&#xa;overall=insufficient" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="380" height="260" as="geometry"/></mxCell>
        <mxCell id="p5-candidates" value="ReleaseCandidateSet 工程合同已实现&#xa;releaseCandidateStrategyIds&#xa;strategyVersions&#xa;excludedStrategyIds + reasons&#xa;candidate 集合在验证前冻结&#xa;失败策略不得静默移除" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="510" y="180" width="360" height="260" as="geometry"/></mxCell>
        <mxCell id="p5-input" value="验证输入&#xa;FTR-1 FormalDataSnapshot&#xa;FTR-2 qualified benchmark&#xa;PortfolioBacktestEngine curves&#xa;cost / rebalance / tradeability constraints&#xa;immutable parameter snapshot" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="940" y="180" width="360" height="260" as="geometry"/></mxCell>
        <mxCell id="p5-service" value="FormalValidationService 已实现，真实指标 gate insufficient&#xa;OOS validation&#xa;Walk-forward windows&#xa;Parameter sensitivity&#xa;Industry / market regime / liquidity groups&#xa;ValidationFailureTaxonomy" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="1370" y="180" width="360" height="260" as="geometry"/></mxCell>
        <mxCell id="p5-metrics" value="FTR-3 硬指标&#xa;releaseEffectivePathCount >= 30&#xa;benchmark 仅 official/trusted&#xa;industryGroupCount >= 3&#xa;walkForwardWindows >= 6&#xa;walkForwardPassedRatio >= 0.6&#xa;parameterSensitivityStatus != insufficient&#xa;groupStabilityStatus != insufficient&#xa;tradeConstraintsComplete=true" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="510" y="540" width="400" height="300" as="geometry"/></mxCell>
        <mxCell id="p5-user" value="用户操作与体验&#xa;1. 选择 candidate 和版本&#xa;2. 运行验证并查看进度&#xa;3. 逐策略查看 OOS / walk-forward / 参数 / 分组&#xa;4. 查看失败窗口和 insufficientWindowCount&#xa;5. 从 Operations 打开 17 audit" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="380" height="300" as="geometry"/></mxCell>
        <mxCell id="p5-pass" value="FTR-3 出门&#xa;allReleaseCandidatesPassed=true&#xa;formalValidationStatus=passed&#xa;formalValidationPassed=true&#xa;失败/排除原因完整&#xa;仍然不改变交易权限" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="1010" y="560" width="330" height="230" as="geometry"/></mxCell>
        <mxCell id="p5-fail" value="Hard Fail / 打回 FTR-3&#xa;失败 candidate 被移除&#xa;无效窗口不计 insufficient&#xa;research proxy 用于 formal pass&#xa;降低阈值只为判绿&#xa;formalValidationPassed 被解释为可下单" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="1410" y="540" width="320" height="280" as="geometry"/></mxCell>
        <mxCell id="p5-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p5-baseline" target="p5-candidates"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p5-candidates" target="p5-input"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p5-input" target="p5-service"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p5-service" target="p5-metrics"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p5-metrics" target="p5-pass"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ftr-page-6" name="6 人工签核执行隔离与 Release Gate">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p6-title" value="FTR-4 至 FTR-6：人工签核、执行隔离与 Release Review" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p6-signbase" value="当前签核合同&#xa;portfolioBacktestReviewService&#xa;buildManualSignoffAudit&#xa;五角色记录均 missing" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="320" height="180" as="geometry"/></mxCell>
        <mxCell id="p6-sign" value="ManualSignoffService 已实现，五角色签核 missing&#xa;data / model / risk / compliance / final_release&#xa;reviewer + reviewedAt + artifact hash + decision&#xa;自动化不得自签核" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="390" height="220" as="geometry"/></mxCell>
        <mxCell id="p6-signaudit" value="FTR-4 证据&#xa;18_manual_signoff_audit.json&#xa;manual_signoff_records.json&#xa;manual_trade_plan_draft_review.json&#xa;signedArtifactHashesMatch=true" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="950" y="150" width="360" height="220" as="geometry"/></mxCell>
        <mxCell id="p6-isobase" value="当前隔离合同&#xa;buildExecutionIsolationAudit&#xa;portfolioBacktest.ts / famsChatService.ts 内嵌阻断&#xa;paperTradingReady=true&#xa;productionAdapterEnabled=false" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="320" height="220" as="geometry"/></mxCell>
        <mxCell id="p6-iso" value="ExecutionIsolationService 已实现并通过隔离回归&#xa;paper/sandbox runtime contract&#xa;真实持仓 mutation 防线&#xa;生产适配器审批记录 missing&#xa;ChatBox / 专家页 / API 同一阻断合同" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="470" y="490" width="390" height="240" as="geometry"/></mxCell>
        <mxCell id="p6-isoaudit" value="FTR-5 证据&#xa;13_execution_isolation_audit.json&#xa;trade_boundary_wording_audit.json&#xa;production_adapter_approval_record.json&#xa;自动化出门时 production 仍 disabled" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="950" y="490" width="360" height="240" as="geometry"/></mxCell>
        <mxCell id="p6-release" value="ReleaseGateService 已实现，release 业务 gate blocked&#xa;只消费 FTR-1 至 FTR-5 结果&#xa;不重新计算、不覆盖 blocker&#xa;输出 FormalReleaseReviewPackage&#xa;releaseApprovalStatus=pending_human_approval" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="1410" y="280" width="330" height="280" as="geometry"/></mxCell>
        <mxCell id="p6-report" value="FTR-6 人类审计入口&#xa;14_release_gate_audit.json&#xa;formal_release_review_manifest.json&#xa;acceptance-report.html&#xa;SUMMARY_FOR_GPT.md&#xa;状态/责任人/失败归属/原始证据可跳转" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="1410" y="650" width="330" height="260" as="geometry"/></mxCell>
        <mxCell id="p6-hard" value="自动化硬边界&#xa;formalTradingReleaseReviewReady 可为 true&#xa;productionAdapterEnabled=false&#xa;formalTradingUnlocked=false&#xa;autoTradeUnlocked=false&#xa;canCreateOrder=false&#xa;orderCreateAllowed=false" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="470" y="820" width="840" height="190" as="geometry"/></mxCell>
        <mxCell id="p6-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-signbase" target="p6-sign"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p6-sign" target="p6-signaudit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-isobase" target="p6-iso"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p6-iso" target="p6-isoaudit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-signaudit" target="p6-release"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-isoaudit" target="p6-release"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p6-release" target="p6-report"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ftr-page-7" name="7 开发计划里程碑与用户路径">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p7-title" value="剩余开发顺序、里程碑和完整用户体验路径" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p7-f0" value="S0-S2 / M0&#xa;基线一致 + 缺陷修复&#xa;私有真实数据回归" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;fillColor=#fff4d6;strokeColor=#b7791f;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="p7-f1" value="FTR-1 / M1&#xa;正式数据治理&#xa;候选字段无 blocker" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;fillColor=#fff0e1;strokeColor=#c96820;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="p7-f2" value="FTR-2 / M2&#xa;Benchmark 资格&#xa;official/trusted" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;fillColor=#fff0e1;strokeColor=#c96820;" vertex="1" parent="1"><mxGeometry x="540" y="150" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="p7-f3" value="FTR-3 / M3&#xa;Formal Validation&#xa;候选集合全部通过" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;fillColor=#fff0e1;strokeColor=#c96820;" vertex="1" parent="1"><mxGeometry x="790" y="150" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="p7-f4" value="FTR-4 / M4&#xa;五角色人工签核&#xa;artifact hash 固定" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;fillColor=#fff4d6;strokeColor=#b7791f;" vertex="1" parent="1"><mxGeometry x="1040" y="150" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="p7-f5" value="FTR-5 / M5&#xa;执行隔离回归&#xa;production disabled" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;fillColor=#fff0e1;strokeColor=#c96820;" vertex="1" parent="1"><mxGeometry x="1290" y="150" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="p7-f6" value="FTR-6 / M6&#xa;Release Review Ready&#xa;等待人类决策" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;fillColor=#fff4d6;strokeColor=#b7791f;" vertex="1" parent="1"><mxGeometry x="1540" y="150" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="p7-path1" value="路径 A 普通用户：真实资产 -> 组合比较&#xa;1 下载模板并导入真实资产 Excel&#xa;2 Dashboard 查看资产与数据健康&#xa;3 ChatBox 运行组合比较并给出结论/关键数字/下一步&#xa;4 工作台显示 provider、benchmark、validation blocker&#xa;5 Operations 追溯输入和 artifact&#xa;门槛：资产与回测输入一致；缺数据有恢复动作；无订单" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="500" height="280" as="geometry"/></mxCell>
        <mxCell id="p7-path2" value="路径 B 研究用户：Candidate -> Validation&#xa;1 选择策略、版本和 release candidate 集合&#xa;2 配置 1年/3年/5年及验证窗口&#xa;3 查看 total-return、回撤、OOS、walk-forward、参数和分组&#xa;4 失败 candidate 保留并显示打回原因&#xa;5 打开 16/17 audit&#xa;门槛：candidate 结果齐全；insufficient 不得写 passed" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="650" y="350" width="500" height="280" as="geometry"/></mxCell>
        <mxCell id="p7-path3" value="路径 C 审核用户：Evidence -> Signoff&#xa;1 数据/模型/风控/合规分别打开证据&#xa;2 提交签核或打回，记录 reviewer/time/hash&#xa;3 final release 审核人查看完整链路&#xa;4 HTML 报告关联 13-18 audit&#xa;门槛：缺任一角色 blocked；自动化不能自签核" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="1240" y="350" width="500" height="280" as="geometry"/></mxCell>
        <mxCell id="p7-path4" value="路径 D 交易边界回归&#xa;ChatBox / Backtest / API 请求 ADD、REDUCE、ORDER_CREATE、AUTO_TRADE&#xa;-> permission gate 返回 blocked + 缺失 gate&#xa;-> 不创建 Operation 订单、不修改持仓&#xa;-> trade_boundary_wording_audit.json 可追溯" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="760" height="220" as="geometry"/></mxCell>
        <mxCell id="p7-audit" value="每个子阶段必须有&#xa;substage plan + PRD 检视 + 真实数据/E2E + JSON artifact + blocker/warning + 失败归属 + 人工 gate&#xa;失败即回到对应 FTR 计划，不允许修改报告文案判绿" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="940" y="720" width="800" height="220" as="geometry"/></mxCell>
        <mxCell id="p7-e01" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-f0" target="p7-f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-f1" target="p7-f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e23" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-f2" target="p7-f3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e34" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p7-f3" target="p7-f4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e45" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-f4" target="p7-f5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e56" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p7-f5" target="p7-f6"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ftr-page-8" name="8 验收门槛出门条件与硬边界">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p8-title" value="FTR 出门合同：自动验收、人工门禁、可声明状态与 Hard Fail" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p8-auto" value="自动化验收（必须全部可复核）&#xa;DPR-001..030 状态/矩阵/验证器一致&#xa;S0-S2 与 FTR manifest 命令退出 0&#xa;真实数据输入与 commit 固定&#xa;13-18 audit + candidate + provider/benchmark 证据完整&#xa;blocked/insufficient/missing 不隐藏&#xa;artifact hashes verified" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="500" height="300" as="geometry"/></mxCell>
        <mxCell id="p8-human" value="人工门禁（自动化不可代替）&#xa;正式 provider 授权与凭据配置&#xa;official/trusted benchmark 资格认可&#xa;数据 / 模型 / 风控 / 合规 / final release 签核&#xa;生产适配器启用审批&#xa;最终正式交易权限变更&#xa;任一缺失：releaseApprovalStatus=pending 或 blocked" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="650" y="160" width="500" height="300" as="geometry"/></mxCell>
        <mxCell id="p8-claims" value="自动化阶段允许声明&#xa;controlledAutomationDevelopmentImplemented=true&#xa;formalDataGovernancePassed=true（仅 FTR-1 通过后）&#xa;benchmarkQualificationPassed=true（仅 FTR-2 通过后）&#xa;formalValidationPassed=true（仅 FTR-3 通过后）&#xa;manualSignoffPassed=true（仅真实签核后）&#xa;executionIsolationPassed=true&#xa;formalTradingReleaseReviewReady=true&#xa;releaseApprovalStatus=pending_human_approval" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="1240" y="150" width="500" height="330" as="geometry"/></mxCell>
        <mxCell id="p8-hard" value="始终禁止 / Hard Fail&#xa;formalTradingReleaseReady=true（无独立人工 release 决策）&#xa;formalTradingUnlocked=true&#xa;autoTradeUnlocked=true&#xa;canCreateOrder=true&#xa;orderCreateAllowed=true&#xa;productionAdapterEnabled=true（无独立审批）&#xa;ChatBox can trade&#xa;ORDER_CREATE allowed / AUTO_TRADE allowed" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="500" height="330" as="geometry"/></mxCell>
        <mxCell id="p8-return" value="失败打回规则&#xa;数据 provider/freshness/coverage/evidence -> FTR-1&#xa;benchmark 类型/授权/总回报 -> FTR-2&#xa;candidate/OOS/walk-forward/参数/分组 -> FTR-3&#xa;reviewer/hash/角色缺失 -> FTR-4&#xa;执行路径可达或权限漂移 -> FTR-5&#xa;报告缺证据、隐藏 blocker、错误 claim -> FTR-6&#xa;drawio/PRD/状态漂移 -> FTR-0" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="650" y="570" width="500" height="330" as="geometry"/></mxCell>
        <mxCell id="p8-review" value="人工审查时必须能回答&#xa;1 下一阶段到底开发什么？&#xa;2 每个目标实体从哪个当前实体演进？&#xa;3 用户在哪里操作、看到什么、如何追溯？&#xa;4 每个 gate 的量化门槛和失败归属是什么？&#xa;5 为什么 review ready 仍不能下单？&#xa;&#xa;审计入口：target-architecture-gap.drawio / read-drawio-output.txt / current-stage-state.json / FTR manifest / acceptance-report.html" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="1240" y="570" width="500" height="330" as="geometry"/></mxCell>
        <mxCell id="p8-e1" value="机器结果" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="p8-auto" target="p8-claims"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e2" value="仍需人类" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="p8-human" target="p8-claims"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e3" value="违规即打回" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="p8-hard" target="p8-return"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e4" value="人工复核" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;fontFamily=Microsoft YaHei;fontSize=12;" edge="1" parent="1" source="p8-claims" target="p8-review"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
