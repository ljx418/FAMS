  <diagram id="08 ChatBox 与 AgentCore 业务入口" name="08 ChatBox 与 AgentCore 业务入口">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="08-title" value="ChatBox 与 PI AgentCore：已开发基础、需修改、待新增、硬边界一图说明；专家 Tab 保留" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#1f2937;fontColor=#ffffff;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1840" height="70" as="geometry" />
        </mxCell>
        <mxCell id="08-legend" value="颜色：灰色=已开发基础；黄色=开发中/需修改；橘黄=未开发/待新增；红色=硬边界；蓝色=用户路径；绿色=目标体验输出。ChatBox 是第一入口，不删除专家模块。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="1800" height="55" as="geometry" />
        </mxCell>
        <mxCell id="08-user" value="用户自然语言入口&#xa;示例：&#xa;红利低波前三只候选&#xa;600887 处于什么区间&#xa;永久组合 vs 全天候组合最近三年收益和最大回撤，并画图&#xa;最近任务为什么失败" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="08-ui" value="已开发基础：前端&#xa;FamsChatBox.tsx&#xa;AppLayout.tsx 全局入口&#xa;快捷问题、行动卡、确认卡&#xa;研究模式边界提示&#xa;原专家 Tab 仍保留&#xa;需修改：任务卡入口 + 普通话结果层级" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=top;fillColor=#e5e7eb;strokeColor=#9ca3af;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="400" y="220" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="08-api" value="已开发基础：后端&#xa;backend/src/routes/chat.ts&#xa;famsChatService&#xa;chatLlmPlannerService&#xa;piAgentCoreAdapter&#xa;白名单工具、会话审计、二次确认&#xa;需修改：全业务工具覆盖与结构化图表" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=top;fillColor=#e5e7eb;strokeColor=#9ca3af;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="760" y="220" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="08-tools" value="可编排业务能力&#xa;红利低波候选与区间&#xa;组合持仓与风险解释&#xa;永久组合/全天候组合 quick-run 对比&#xa;任务、审计、草案、页面跳转&#xa;持久化动作需确认" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="1140" y="220" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="08-outcome" value="目标体验输出&#xa;普通用户：结论 / 关键数字 / 下一步 / 数据可信 / 图表 / 工作台承接。&#xa;资深用户：继续使用多模块专家页、完整指标、筛选、参数和 artifactRefs。&#xa;两条路径共享同一审计和交易 Gate。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="1530" y="220" width="330" height="170" as="geometry" />
        </mxCell>
        <mxCell id="08-gap1" value="开发中/需修改：Chat UX 展示层&#xa;chatBoxExperienceOptimized=false&#xa;plainLanguageChatResultReady=false&#xa;dataHealthExplanationReady=false&#xa;技术细节未统一折叠&#xa;移动端需复核&#xa;不能只显示 raw blockedReasons/evidenceRefs" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="400" y="470" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="08-gap2" value="开发中/需修改：AgentCore 集成深度&#xa;piAgentCoreRuntimeIntegrated=true&#xa;piLlmAgentLoopEnabled=partial_controlled_intent_router&#xa;deterministic fallback 保留&#xa;fullBusinessToolCoverageReady=false&#xa;chatStreamingReady=false" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="760" y="470" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="08-target1" value="未开发/待新增：CB-F / UX-7 + UX-8&#xa;WelcomeTaskBoard / AssistantMessage / StructuredResultRenderer&#xa;ActionCardList / DataHealthNotice / AgentStatusDetails&#xa;UserTaskWorkbench / JourneyStepper / ExpertPageChatExplain&#xa;chatbox_ux_optimization_audit.json / frontend_ux_consistency_audit.json / dual_track_ux_audit.json&#xa;后续再做 SSE / WebSocket 流式事件" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="1140" y="470" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="08-boundary" value="硬边界&#xa;不得调用非白名单工具&#xa;不得直接访问 shell / 文件系统 / 不受控网络&#xa;不得创建订单&#xa;不得输出正式 ADD / REDUCE / ORDER_CREATE / AUTO_TRADE&#xa;任何副作用动作必须二次确认并落审计" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=top;fillColor=#f4cccc;strokeColor=#cc0000;fontColor=#990000;" vertex="1" parent="1">
          <mxGeometry x="1530" y="470" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="08-accept" value="开发及验收计划&#xa;CB-1 到 CB-5：功能链路、工具权限、结构化结果、Operation 确认、交易边界。&#xa;CB-F / UX-7：欢迎任务卡、普通话结果层级、数据健康提示、技术细节折叠、消息级操作、移动端可读性。&#xa;UX-8：ChatBox-&gt;工作台、工作台-&gt;专家页、专家页-&gt;ChatBox 解释；保留多模块专家入口。&#xa;验收：chatbox_ux_optimization_audit.json；双轨路径截图；formalTradingUnlocked=false、autoTradeUnlocked=false、canCreateOrder=false。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#999999;fontColor=#1f2937;" vertex="1" parent="1">
