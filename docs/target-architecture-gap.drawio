        <mxCell id="p1-blockers" value="当前真实阻断（不能伪绿）&#xa;Formal data governance = blocked&#xa;official/trusted total-return 未确认&#xa;Formal validation = insufficient，0/7 passed&#xa;data/model/risk/compliance/final_release 全 missing&#xa;Production adapter = disabled&#xa;Release gate = blocked" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#5c3b00;spacing=14;" vertex="1" parent="1"><mxGeometry x="650" y="220" width="500" height="330" as="geometry"/></mxCell>
        <mxCell id="p1-stage" value="下一步顺序（工程修复 -> 业务闭环）&#xa;S0 PRD/状态/架构一致性&#xa;S1 已知接口缺陷修复&#xa;S2 私有真实数据全量回归&#xa;FTR-1 正式数据授权治理&#xa;FTR-2 official/trusted benchmark&#xa;FTR-3 Formal Validation&#xa;FTR-4 五角色人工签核 + Release 决策" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;fontColor=#5c3b00;spacing=14;" vertex="1" parent="1"><mxGeometry x="650" y="600" width="500" height="310" as="geometry"/></mxCell>
