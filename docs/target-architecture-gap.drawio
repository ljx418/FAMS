          <mxGeometry x="560" y="140" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6_s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=0;spacing=8;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;fontColor=#17385b;strokeWidth=1;" value="路径 C：红利低波研究
