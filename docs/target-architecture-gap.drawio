        <mxCell id="07-m3" value="M3 UX 实现出门&#xa;ordinaryUserExperienceReady=true&#xa;frontendComplexityReduced=true&#xa;chatBoxExperienceOptimized=true&#xa;桌面/平板/移动截图通过。" style="rounded=1;whiteSpace=wrap;html=1;spacing=10;fontSize=12;align=left;verticalAlign=top;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="970" y="140" width="390" height="190" as="geometry" />
