          <mxGeometry x="1080" y="140" width="390" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p6_s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=0;spacing=8;align=left;verticalAlign=top;fillColor=#ffe6c7;strokeColor=#d97706;fontColor=#6b3b00;strokeWidth=1;" value="路径 D：人工计划草案
生成草案 -&gt; 查看 blocker -&gt; 人工签核前 formalTargetWeight=0 -&gt; 尝试交易意图被阻断。" vertex="1">
          <mxGeometry x="80" y="370" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p6_s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=0;spacing=8;align=left;verticalAlign=top;fillColor=#f1edff;strokeColor=#7c3aed;fontColor=#3b1d78;strokeWidth=1;" value="路径 E：审计复核
