  <diagram id="v2px-page-1" name="1 目标体验与阶段边界">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p1-title" value="V2-PX External Brain：目标体验与当前文档阶段" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=26;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p1-legend" value="绿=已开发复用　黄=现有实体需修改　橙=待新增　蓝=合同/证据　红=硬边界　灰=现有基础或非目标" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;fillColor=#f3f4f6;strokeColor=#6b7280;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1720" height="50" as="geometry"/></mxCell>
        <mxCell id="p1-problem" value="当前用户问题（现有基础）&#xa;ChatBox 可视区域有限&#xa;复盘、任务、证据分散在多个页面&#xa;刷新/重开缺统一 workspace 恢复&#xa;重复点击可能产生重复标签或任务" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#f3f4f6;strokeColor=#6b7280;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="360" height="270" as="geometry"/></mxCell>
        <mxCell id="p1-side" value="目标 Side Panel（待新增）&#xa;360/420px 轻入口&#xa;连接状态 + 当前任务&#xa;简明结论/依据/时间/下一步&#xa;打开或复用完整工作台&#xa;不承载大型图表和完整 DAG" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="520" y="220" width="360" height="300" as="geometry"/></mxCell>
        <mxCell id="p1-work" value="目标 Workspace Page（待新增）&#xa;768/1280px 完整宿主&#xa;来源库 / 来源详情 / 问答&#xa;Operation 追踪 / Review 图谱&#xa;普通话摘要 + 折叠证据&#xa;刷新、断连和重开恢复" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="980" y="220" width="360" height="300" as="geometry"/></mxCell>
        <mxCell id="p1-host" value="FAMS Host App（需修改）&#xa;FamsChatBox.tsx&#xa;DailyReviews.tsx&#xa;Operations.tsx&#xa;统一“在外部大脑打开”&#xa;只传受控业务标识" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="1410" y="220" width="320" height="300" as="geometry"/></mxCell>
        <mxCell id="p1-outcome" value="完成后的目标体验&#xa;三个入口进入同一研究任务&#xa;重复打开聚焦同一 workspace tab&#xa;结论、来源、任务和证据可追溯&#xa;无法恢复时明确 blocked，不显示伪成功" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="520" y="630" width="820" height="250" as="geometry"/></mxCell>
        <mxCell id="p1-bound" value="当前硬边界&#xa;仅文档开发，PX-1 未授权&#xa;不创建 extension package&#xa;不修改前后端生产源码&#xa;不使用 mock 冒充 Chrome evidence&#xa;正式交易/自动交易/订单创建恒为 false" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;fontColor=#6b1d1a;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="360" height="270" as="geometry"/></mxCell>
        <mxCell id="p1-nongoal" value="本阶段非目标&#xa;不新增投资模型/行情 provider&#xa;不建设通用网页抓取或图数据库&#xa;不做 Chrome Web Store 发布&#xa;不宣称远程多用户生产安全" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#f3f4f6;strokeColor=#6b7280;spacing=14;" vertex="1" parent="1"><mxGeometry x="1410" y="630" width="320" height="250" as="geometry"/></mxCell>
        <mxCell id="p1-e1" value="快速入口" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p1-problem" target="p1-side"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e2" value="深入核查" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p1-side" target="p1-work"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e3" value="携带当前上下文" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p1-host" target="p1-work"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e4" value="共同目标" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p1-work" target="p1-outcome"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e5" value="不可越界" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p1-bound" target="p1-outcome"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2px-page-2" name="2 当前架构与目标架构差异">
