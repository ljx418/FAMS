      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p4-title" value="目标用户路径：三入口共享同一任务，Side Panel 简明，Workspace 完整" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p4-entry1" value="入口 A（待新增）&#xa;Chrome Side Panel&#xa;查看来源 / 打开工作台 / 在工作台定位" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="p4-entry2" value="入口 B（待新增）&#xa;独立 Workspace Page&#xa;直接切换五类视图/定位当前对象" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="p4-entry3" value="入口 C（需修改）&#xa;FAMS ChatBox / 复盘 / 任务中心&#xa;携带 reviewId / operationId / sourceRef" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="450" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="p4-route" value="Background 路由（待新增）&#xa;schema + permission + policy&#xa;workspaceId / canonicalRouteKey&#xa;routeId / correlationId&#xa;同 key 去重、冲突拒绝" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="340" height="260" as="geometry"/></mxCell>
        <mxCell id="p4-sidewire" value="Side Panel 360/420 目标原型&#xa;┌ FAMS 外部大脑 · 已连接 ┐&#xa;│ 当前任务 + 数据时间      │&#xa;│ 简明结论（最多 5 行）    │&#xa;│ 查看依据                  │&#xa;│ 在完整工作台打开          │&#xa;│ 快速提问 + 最近任务       │&#xa;└ 不放大型图表/完整 DAG ┘" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="675" width="730" height="290" as="geometry"/></mxCell>
        <mxCell id="p4-i1" value="来源库 source_library&#xa;Operation artifact + Review evidence 索引" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="130" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-i2" value="来源详情 source_detail&#xa;来源/时间/可信状态/关联任务" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="250" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-i3" value="问答 ask&#xa;famsChatService 结构化摘要 + fallback" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="370" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-i4" value="追踪 trace&#xa;Operation timeline + task/artifact" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="490" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-i5" value="图谱 graph&#xa;Daily Review DAG + evidence 关系" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="610" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-workwire" value="Workspace 768/1280 目标原型&#xa;┌ 工作区身份 · 已恢复 · 研究模式 ┐&#xa;│ 左侧：五类视图 / 最近任务       │&#xa;│ 主区：结论摘要 + 当前视图       │&#xa;│ 图表 / 时间线 / DAG / 来源详情  │&#xa;│ 底部：默认折叠证据抽屉          │&#xa;└ 失败时 RecoveryBanner + 下一步 ┘" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="180" width="420" height="400" as="geometry"/></mxCell>
        <mxCell id="p4-states" value="六状态验收（两容器都必须有）&#xa;未连接 / 加载 / 空 / 失败 / 恢复 / 阻断&#xa;每种状态包含：原因 + 当前事实 + 下一步&#xa;禁止空白页、原始 HTTP 异常或伪 success" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="650" width="420" height="240" as="geometry"/></mxCell>
        <mxCell id="p4-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p4-entry1" target="p4-route"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p4-entry2" target="p4-route"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p4-entry3" target="p4-route"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e4" value="规范化 intent" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p4-route" target="p4-i3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e5" value="完整呈现" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p4-i3" target="p4-workwire"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e6" value="快速呈现" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p4-route" target="p4-sidewire"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e7" value="所有状态可理解" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p4-workwire" target="p4-states"><mxGeometry relative="1" as="geometry"/></mxCell>
