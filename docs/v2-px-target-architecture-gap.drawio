        <mxCell id="p2-r4c" value="待新增 Route A.1&#xa;wxt.config.ts + 三 entrypoint&#xa;intentRouter / workspaceTabManager&#xa;idempotencyRegistry / workspaceStateStore&#xa;SidePanelApp / WorkspaceApp" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="765" width="490" height="150" as="geometry"/></mxCell>
