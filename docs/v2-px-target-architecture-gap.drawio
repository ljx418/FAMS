      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p2-title" value="当前实体 → 当前缺口 → 目标实体 → 用户结果" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=26;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p2-h1" value="已开发/可复用" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fillColor=#e8f5ec;strokeColor=#2f7d4a;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="360" height="50" as="geometry"/></mxCell>
        <mxCell id="p2-h2" value="当前缺口/风险" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fillColor=#fff4d6;strokeColor=#b7791f;" vertex="1" parent="1"><mxGeometry x="460" y="125" width="350" height="50" as="geometry"/></mxCell>
        <mxCell id="p2-h3" value="需修改/待新增的具体实体" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fillColor=#fff0e1;strokeColor=#c96820;" vertex="1" parent="1"><mxGeometry x="870" y="125" width="490" height="50" as="geometry"/></mxCell>
        <mxCell id="p2-h4" value="目标效果/验收" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fillColor=#e7f0f8;strokeColor=#315f8c;" vertex="1" parent="1"><mxGeometry x="1420" y="125" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p2-r1a" value="Web 体验（已开发）&#xa;frontend/src/App.tsx&#xa;AppLayout.tsx / FamsChatBox.tsx&#xa;DailyReviews.tsx / Operations.tsx" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r1b" value="入口分散；ChatBox 空间有限；没有 extension bridge；相同业务对象无法直接送入统一 workspace" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=10;" vertex="1" parent="1"><mxGeometry x="460" y="205" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r1c" value="需修改&#xa;frontend/src/services/pxExternalBrainBridge.ts&#xa;components/external-brain/OpenInExternalBrainButton.tsx&#xa;接入 ChatBox / Daily Review / Operations" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="205" width="490" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r1d" value="三个 FAMS 页面都能携带受控 ID 打开同一工作区；扩展缺失时有可理解降级" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=10;" vertex="1" parent="1"><mxGeometry x="1420" y="205" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r2a" value="FAMS API/服务（已开发）&#xa;routes/chat.ts / dailyReview.ts / operation.ts&#xa;famsChatService / dailyReviewService&#xa;operationService / dailyReviewWorkflowService" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="360" height="170" as="geometry"/></mxCell>
        <mxCell id="p2-r2b" value="现有 API 按业务页面组织，没有五 intent 统一 read model；extension 若直接拼接各接口会产生耦合和语义漂移" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=10;" vertex="1" parent="1"><mxGeometry x="460" y="385" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="p2-r2c" value="待新增（只读聚合）&#xa;backend/src/routes/externalBrain.ts&#xa;services/external-brain/externalBrainReadService.ts&#xa;externalBrainPolicyService.ts&#xa;extension FamsDomainAdapter.ts / FamsApiClient.ts" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="385" width="490" height="170" as="geometry"/></mxCell>
        <mxCell id="p2-r2d" value="五 intent 复用同一业务事实；不复制投资计算；交易 policy 保持四锁 false" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=10;" vertex="1" parent="1"><mxGeometry x="1420" y="385" width="340" height="170" as="geometry"/></mxCell>
        <mxCell id="p2-r3a" value="PX-0 合同（已开发）&#xa;docs/schemas/v2-px-*.schema.json&#xa;verify-v2-px-semantic-contract.ts&#xa;正反例 fixtures" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="585" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r3b" value="只能证明合同能拦截已知假绿；没有 WXT 包、真实 UI、browser lifecycle 或 Chrome evidence" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=10;" vertex="1" parent="1"><mxGeometry x="460" y="585" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r3c" value="待新增验收实体&#xa;tests/intent-route.spec.ts&#xa;workspace-host.spec.ts / sidepanel-entry.spec.ts&#xa;lifecycle-recovery.spec.ts&#xa;collect-real-chrome-evidence.mjs" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="585" width="490" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r3d" value="真实 chrome-extension:// URL、extensionId、版本、trace、事件、hash、commit 均可复核" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=10;" vertex="1" parent="1"><mxGeometry x="1420" y="585" width="340" height="150" as="geometry"/></mxCell>
