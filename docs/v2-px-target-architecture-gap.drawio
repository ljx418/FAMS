      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p2-title" value="当前实体 → 当前缺口 → 目标实体 → 用户结果" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=26;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p2-h1" value="已开发/可复用" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fillColor=#e8f5ec;strokeColor=#2f7d4a;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="360" height="50" as="geometry"/></mxCell>
        <mxCell id="p2-h2" value="当前缺口/风险" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fillColor=#fff4d6;strokeColor=#b7791f;" vertex="1" parent="1"><mxGeometry x="460" y="125" width="350" height="50" as="geometry"/></mxCell>
        <mxCell id="p2-h3" value="已实现目标实体与剩余补强" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fillColor=#e2f0d9;strokeColor=#4f8a3c;" vertex="1" parent="1"><mxGeometry x="870" y="125" width="490" height="50" as="geometry"/></mxCell>
        <mxCell id="p2-h4" value="目标效果/验收" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;fillColor=#e7f0f8;strokeColor=#315f8c;" vertex="1" parent="1"><mxGeometry x="1420" y="125" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p2-r1a" value="Web 体验（已开发）&#xa;frontend/src/App.tsx&#xa;AppLayout.tsx / FamsChatBox.tsx&#xa;DailyReviews.tsx / Operations.tsx" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r1b" value="入口分散；ChatBox 空间有限；没有 extension bridge；相同业务对象无法直接送入统一 workspace" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=10;" vertex="1" parent="1"><mxGeometry x="460" y="205" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r1c" value="已实现（PX4B）&#xa;frontend/src/services/pxExternalBrainBridge.ts&#xa;components/external-brain/OpenInExternalBrainButton.tsx&#xa;ChatBox / Daily Review / Operations 三入口" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="205" width="490" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r1d" value="三个 FAMS 页面都能携带受控 ID 打开同一工作区；扩展缺失时有可理解降级" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=10;" vertex="1" parent="1"><mxGeometry x="1420" y="205" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r2a" value="FAMS API/服务（已开发）&#xa;routes/chat.ts / dailyReview.ts / operation.ts&#xa;famsChatService / dailyReviewService&#xa;operationService / dailyReviewWorkflowService" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="360" height="170" as="geometry"/></mxCell>
        <mxCell id="p2-r2b" value="现有 API 按业务页面组织，没有五 intent 统一 read model；extension 若直接拼接各接口会产生耦合和语义漂移" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=10;" vertex="1" parent="1"><mxGeometry x="460" y="385" width="350" height="170" as="geometry"/></mxCell>
        <mxCell id="p2-r2c" value="已实现（有界 Query/Ask）&#xa;routes/externalBrain.ts + externalBrainTypes.ts&#xa;externalBrainReadService.ts / AskService.ts&#xa;externalBrainPolicyService.ts&#xa;extension FamsDomainAdapter.ts / FamsApiClient.ts" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="385" width="490" height="170" as="geometry"/></mxCell>
        <mxCell id="p2-r2d" value="Read 只读；Ask 只允许 read/quick compute&#xa;五 intent 复用同一业务事实&#xa;不自动确认，不复制计算，四锁 false" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=10;" vertex="1" parent="1"><mxGeometry x="1420" y="385" width="340" height="170" as="geometry"/></mxCell>
        <mxCell id="p2-r3a" value="PX-0 合同（已开发）&#xa;docs/schemas/v2-px-*.schema.json&#xa;verify-v2-px-semantic-contract.ts&#xa;正反例 fixtures" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="585" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r3b" value="current intent-route/2、command/1 仅为 PX-0 基线&#xa;target v3/v2 尚未实现；没有 WXT/UI/lifecycle/Chrome evidence" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=10;" vertex="1" parent="1"><mxGeometry x="460" y="585" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r3c" value="验收实体（分阶段已实现）&#xa;contracts/router/workspace/sidepanel/host-bridge tests&#xa;Workspace/SidePanel/Host Chrome verifier&#xa;待补：lifecycle recovery + PX6 汇总" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="585" width="490" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r3d" value="真实 chrome-extension:// URL、extensionId、版本、trace、事件、hash、commit 均可复核" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=10;" vertex="1" parent="1"><mxGeometry x="1420" y="585" width="340" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r4a" value="Browser Extension（当前不存在）&#xa;packages/fams-v2-px-extension = missing&#xa;background / sidepanel / workspace = missing" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#f3f4f6;strokeColor=#6b7280;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="360" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r4b" value="无法证明权限、路由、tab 复用、状态单写、刷新恢复和 headless Chrome Side Panel 可行" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=10;" vertex="1" parent="1"><mxGeometry x="460" y="765" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r4c" value="Route A.1 已技术验证&#xa;wxt.config.ts + 三 entrypoint&#xa;intentRouter / workspaceTabManager&#xa;idempotencyRegistry / chromeStorage&#xa;SidePanelApp / WorkspaceApp&#xa;待补：压力幂等与完整恢复" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="765" width="490" height="150" as="geometry"/></mxCell>
        <mxCell id="p2-r4d" value="先 PX-1 验证可行性；失败返回 ADR，不得越级实现 PX-2+" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=10;" vertex="1" parent="1"><mxGeometry x="1420" y="765" width="340" height="150" as="geometry"/></mxCell>
