  <diagram id="v2px-page-5" name="5 权限状态数据与恢复边界">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p5-title" value="最小权限 + Background 单写 + FAMS 业务事实 + 可推导恢复" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p5-user" value="用户动作&#xa;点击“连接本地 FAMS”&#xa;看到权限用途和精确地址&#xa;允许或拒绝，不静默扩权" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="330" height="190" as="geometry"/></mxCell>
        <mxCell id="p5-perm" value="Manifest 合同（待新增）&#xa;required: sidePanel,tabs,storage&#xa;hostPermissions=[]（安装默认无）&#xa;optionalHostPermissions=精确 3000/4000&#xa;CSP self；禁止 remote code / all_urls 通配权限" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="480" y="160" width="390" height="220" as="geometry"/></mxCell>
        <mxCell id="p5-bg" value="Background（待新增/单写者）&#xa;验证 sender origin/schema/policy&#xa;唯一 FAMS 网络访问者&#xa;活动任务 2 秒有界轮询&#xa;失败指数退避；终态/无容器停止" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="980" y="160" width="380" height="240" as="geometry"/></mxCell>
        <mxCell id="p5-fams" value="FAMS 后端（已开发基础）&#xa;Prisma 保存持仓/复盘/Operation/artifact&#xa;现有业务 service 是唯一计算事实&#xa;目标 read facade 只聚合，不复制计算" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="1450" y="160" width="310" height="240" as="geometry"/></mxCell>
        <mxCell id="p5-session" value="chrome.storage.session（待新增）&#xa;routeId / correlationId&#xa;idempotencyKey / live container&#xa;当前 workspace 状态&#xa;background 读写，容器只订阅" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="480" y="500" width="390" height="220" as="geometry"/></mxCell>
        <mxCell id="p5-local" value="chrome.storage.local（待新增）&#xa;仅最小恢复索引 workspaceId/sourceRef&#xa;不保存账户截图、cookie、token&#xa;不保存完整业务结果" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="980" y="500" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="p5-flow" value="恢复状态机（待新增）&#xa;容器 start → 读取 session&#xa;缺失 → 读取 local 最小索引&#xa;background 重取 FAMS 业务事实&#xa;成功 → resume event&#xa;失败 → blocked event + RecoveryBanner" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="330" height="280" as="geometry"/></mxCell>
        <mxCell id="p5-life" value="生命周期必须由事件推导&#xa;Side Panel：start/resume/reconnect/close&#xa;Workspace：start/resume/reconnect/close&#xa;Background：route/reconnect/blocked&#xa;汇总状态不能由报告自称" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="1450" y="500" width="310" height="240" as="geometry"/></mxCell>
        <mxCell id="p5-hard" value="安全和业务硬边界&#xa;secret/cookie/token 进入证据 = hard fail&#xa;未授权时 API 请求数 = 0&#xa;broker order 请求数 = 0&#xa;formalTradingUnlocked / autoTradeUnlocked / canCreateOrder / orderCreateAllowed 恒 false&#xa;PX-1 只验证本地单用户，不冒充生产身份安全" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="480" y="820" width="880" height="210" as="geometry"/></mxCell>
        <mxCell id="p5-e1" value="主动授权" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p5-user" target="p5-perm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e2" value="授权后访问" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p5-perm" target="p5-bg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e3" value="只读 read model" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p5-bg" target="p5-fams"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e4" value="写 live state" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p5-bg" target="p5-session"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e5" value="写最小索引" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p5-bg" target="p5-local"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e6" value="恢复读取" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p5-flow" target="p5-session"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e7" value="导出事件" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p5-bg" target="p5-life"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e8" value="不可绕过" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p5-bg" target="p5-hard"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2px-page-6" name="6 开发及验收计划">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p6-title" value="顺序开发：每阶段先产生用户结果和证据，再允许进入下一阶段" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p6-d0" value="D0 文档重构（当前）&#xa;PRD 20 项 + 原型 + 目标架构&#xa;8 页 draw.io + 里程碑 + 验收目录&#xa;出门：只可请求用户批准 PX-1&#xa;生产源码变更=0" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="350" height="220" as="geometry"/></mxCell>
        <mxCell id="p6-px1" value="PX-1 可行性 Spike（待批准）&#xa;最小 WXT + 三 entrypoint&#xa;optional permission + /health&#xa;tab 复用 + lifecycle + 真实 Chrome&#xa;用户效果：真实双容器空壳可运行&#xa;失败：RETURN_TO_ADR" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="360" height="240" as="geometry"/></mxCell>
        <mxCell id="p6-px2" value="PX-2 Workspace（未开发）&#xa;WorkspaceApp/Router + 五视图外壳&#xa;摘要/证据分层 + 六状态 + 刷新恢复&#xa;用户效果：768/1280 完整工作台可用&#xa;验收：host/viewports/state matrix" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="920" y="150" width="360" height="240" as="geometry"/></mxCell>
        <mxCell id="p6-px3" value="PX-3 Side Panel + Host App（未开发）&#xa;SidePanelApp / ConnectionGate&#xa;FAMS bridge + 统一打开按钮&#xa;用户效果：360/420 快速入口可用&#xa;验收：轻入口、三页面跳转、降级" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="1360" y="150" width="360" height="240" as="geometry"/></mxCell>
        <mxCell id="p6-px4" value="PX-4 Router + FAMS Adapter（未开发）&#xa;intent/tab/idempotency/state ownership&#xa;externalBrain read facade + policy&#xa;用户效果：三入口五 intent 读取同一事实&#xa;验收：20 次重复、0 副作用、0 订单请求" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="250" y="540" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="p6-px5" value="PX-5 生命周期与恢复（未开发）&#xa;Back/Forward/Refresh/关闭重开&#xa;FAMS 断连、background reconnect&#xa;extension reload/update&#xa;用户效果：5 秒内 restored 或明确 blocked&#xa;验收：状态 100% 由事件推导" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="700" y="540" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="p6-px6" value="PX-6 产品化候选（未开发）&#xa;Playwright + Chrome CDP&#xa;G1-G7 + JSON/HTML + 人工体验清单&#xa;四视口/隐私/防假绿全部通过&#xa;用户效果：可按 commit 复核完整体验&#xa;仍不开放生产交易或远程发布" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="1150" y="540" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="p6-stop" value="全阶段停止规则&#xa;未获用户批准不得启动 PX-1&#xa;PX-1 任一关键可行性失败返回 ADR&#xa;任一阶段证据/负例失败不得进入下一阶段&#xa;不得并行越级开发 PX-2+&#xa;不得用自动通过代替人工体验核查" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="480" y="870" width="800" height="170" as="geometry"/></mxCell>
        <mxCell id="p6-e1" value="用户另行批准" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p6-d0" target="p6-px1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e2" value="技术验证 + 人工确认" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-px1" target="p6-px2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e3" value="Workspace 出门" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-px2" target="p6-px3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e4" value="双入口出门" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-px3" target="p6-px4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e5" value="路由/适配出门" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-px4" target="p6-px5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e6" value="恢复出门" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-px5" target="p6-px6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e7" value="任何失败" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p6-px5" target="p6-stop"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2px-page-7" name="7 项目里程碑风险与回退">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p7-title" value="M0-M6 里程碑：风险在最早可验证阶段关闭，失败可回退" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p7-m0" value="M0 文档评审就绪（当前）&#xa;20/20 追踪 + 8 页图 + 状态一致&#xa;人类可判断体验/架构/验收风险" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-m1" value="M1 Route A 技术验证&#xa;真实 Chrome 双容器&#xa;权限/CORS/证据通过" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-m2" value="M2 Workspace Accepted&#xa;五视图/六状态&#xa;768/1280 + 刷新恢复" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="530" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-m3" value="M3 Side Panel Accepted&#xa;360/420 轻入口&#xa;Host App 三页面跳转" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="770" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-m4" value="M4 Intent/Adapter Accepted&#xa;三入口五 intent&#xa;复用 FAMS 事实/幂等" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="1010" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-m5" value="M5 Lifecycle Accepted&#xa;必测恢复场景 100%&#xa;restored 或 blocked" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="1250" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-m6" value="M6 产品化候选&#xa;G1-G7 + HTML + 人工体验&#xa;本地候选，不是生产发布" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="1490" y="140" width="270" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-risk1" value="风险 R1：Side Panel/Workspace headless 自动化不可控&#xa;最早验证：M1 / PX-1&#xa;门槛：unpacked Chrome + CDP 真实 trace&#xa;失败：返回 ADR，评估 Web Workspace + launcher" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="p7-risk2" value="风险 R2：optional permission / CORS 不可用&#xa;最早验证：M1 / PX-1&#xa;门槛：用户授权后 /health 200，未授权请求 0&#xa;失败：修改 ADR；禁止静默增加 all_urls 通配权限" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="490" y="390" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="p7-risk3" value="风险 R3：五 intent 与 FAMS API 粒度不匹配&#xa;最早验证：M2/M4&#xa;缓解：只读聚合 facade，不复制 service&#xa;失败：缩小 read model；不得改变 intent 名称伪通过" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="920" y="390" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="p7-risk4" value="风险 R4：状态漂移/重复副作用/隐私泄露&#xa;最早验证：M1/M4/M5&#xa;缓解：Background 单写 + idempotency + 私有 evidence&#xa;失败：对应阶段 hard fail，不进入 M6" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="1350" y="390" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="p7-review" value="每个里程碑的评审对象&#xa;用户可见结果 + 实际代码实体 + 自动测试 + 原始证据 + 失败归属&#xa;只有前一里程碑全部通过且需要的人工确认完成，后一里程碑才可开始" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="250" y="700" width="850" height="180" as="geometry"/></mxCell>
        <mxCell id="p7-hard" value="不会被 M6 自动解除的边界&#xa;生产身份/远程 origin/商店发布另立项目&#xa;正式交易、自动交易和券商 adapter 继续禁止&#xa;自动验收不能替代人类最终体验结论" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="1160" y="700" width="580" height="180" as="geometry"/></mxCell>
        <mxCell id="p7-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p7-m0" target="p7-m1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-m1" target="p7-m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-m2" target="p7-m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-m3" target="p7-m4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-m4" target="p7-m5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-m5" target="p7-m6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e7" value="共同评审" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p7-m4" target="p7-review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e8" value="仍受约束" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p7-m6" target="p7-hard"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2px-page-8" name="8 验收门槛与出门条件">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p8-title" value="拒绝“三无验收”：每个场景都有前置条件、操作、阈值、证据和失败归属" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p8-a1" value="AC01 首次连接（PX-1）&#xa;前置：FAMS 3000/4000 已启动、未授权&#xa;操作：打开 Side Panel → 点击连接 → 确认 origin&#xa;阈值：未授权请求=0；授权后 /health=200；无 all_urls 通配权限&#xa;证据：permission audit + 截图 + network log" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="410" height="190" as="geometry"/></mxCell>
        <mxCell id="p8-a2" value="AC02-04 提问/复用/Host 跳转（PX-3/4）&#xa;前置：已连接且存在 review/operation&#xa;操作：提问；连续 20 次打开；从三个 FAMS 页面跳转&#xa;阈值：摘要字段完整；tab=1；重复 operation=0；三入口对象一致&#xa;证据：360/420 截图 + entry/tab trace" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=12;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="410" height="190" as="geometry"/></mxCell>
        <mxCell id="p8-a3" value="AC05-06 五 intent + 四视口（PX-2/4）&#xa;前置：存在 artifact/review/operation&#xa;操作：逐个打开五视图；运行 360/420/768/1280&#xa;阈值：5/5 真实 read model；scrollWidth&lt;=clientWidth；console error=0&#xa;证据：intent audit + 四视口截图 + DOM audit" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="130" width="410" height="190" as="geometry"/></mxCell>
        <mxCell id="p8-a4" value="AC07 生命周期（PX-5）&#xa;前置：工作区已打开&#xa;操作：Back/Forward/Refresh/关闭重开/断连/reload&#xa;阈值：所有场景 5 秒内为 restored 或 blocked；100% 由事件推导&#xa;证据：lifecycle events + Chrome trace" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=12;" vertex="1" parent="1"><mxGeometry x="1360" y="130" width="400" height="190" as="geometry"/></mxCell>
        <mxCell id="p8-a5" value="AC08 六状态降级（PX-2/3/5）&#xa;操作：触发未连接/加载/空/失败/恢复/阻断&#xa;阈值：6/6 有原因和下一步；伪 success=0&#xa;证据：state matrix audit + 截图&#xa;失败归属：产生状态的最早阶段" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=12;" vertex="1" parent="1"><mxGeometry x="170" y="370" width="450" height="180" as="geometry"/></mxCell>
        <mxCell id="p8-a6" value="AC09 隐私和交易边界（全阶段）&#xa;操作：运行全路径并扫描 evidence/network/UI&#xa;阈值：secret/cookie/token/账户原图=0；broker order 请求=0；四锁恒 false&#xa;证据：redaction + trade boundary audit&#xa;失败归属：hard fail，禁止进入下一阶段" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=12;" vertex="1" parent="1"><mxGeometry x="675" y="370" width="450" height="180" as="geometry"/></mxCell>
        <mxCell id="p8-a7" value="AC10 防假绿（PX-6/来源阶段）&#xa;操作：删除截图、改 hash、换 mock URL、制造事件乱序&#xa;阈值：全部负例必须失败；正例通过；commit 可复核&#xa;证据：negative fixtures + G1-G7 audit&#xa;失败归属：PX-6 或产生坏证据的阶段" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=12;" vertex="1" parent="1"><mxGeometry x="1180" y="370" width="450" height="180" as="geometry"/></mxCell>
        <mxCell id="p8-doc" value="当前文档阶段 D0 出门&#xa;PRD/traceability = 20/20&#xa;draw.io = 8 页中文且 XML 可解析&#xa;实体状态、里程碑、场景和风险无冲突&#xa;生产源码 diff = 0&#xa;最多声明 documentationReadyForImplementationReview=true" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="80" y="650" width="500" height="250" as="geometry"/></mxCell>
        <mxCell id="p8-px" value="未来 V2-PX 候选出门（尚未实现）&#xa;PX-1～PX-6 顺序完成&#xa;真实双容器 Chrome acceptance 通过&#xa;G1-G7 全绿 + 人工体验核查通过&#xa;四视口/隐私/恢复/幂等全部达到阈值&#xa;最多声明 v2PxProductizationCandidate=true" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="650" y="650" width="500" height="250" as="geometry"/></mxCell>
        <mxCell id="p8-hard" value="始终不能由上述出门自动推出&#xa;implementationApprovalStatus 由用户明确指令改变&#xa;生产身份/远程 origin/Chrome Store 发布&#xa;正式交易、自动交易、订单创建&#xa;生产 broker adapter 启用&#xa;自动化不能代替人类最终决定" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="1220" y="650" width="500" height="250" as="geometry"/></mxCell>
        <mxCell id="p8-approval" value="当前审批状态：产品目标已认可；实际开发未批准&#xa;px1FeasibilitySpikeAllowed=false　px2PlusAllowed=false" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fillColor=#fde8e7;strokeColor=#b43a36;" vertex="1" parent="1"><mxGeometry x="370" y="950" width="1060" height="70" as="geometry"/></mxCell>
        <mxCell id="p8-e1" value="文档通过后请求批准" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p8-doc" target="p8-approval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e2" value="另行批准且逐阶段完成" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p8-approval" target="p8-px"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e3" value="不可推导" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p8-px" target="p8-hard"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
