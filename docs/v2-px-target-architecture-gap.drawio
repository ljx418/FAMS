  <diagram id="v2px-page-3" name="3 目标分层架构与实体交互">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p3-title" value="Route A.1 目标分层：容器只发命令，Background 单写，FAMS 保持业务事实" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p3-host" value="入口 1：FAMS Host（需修改）&#xa;pxExternalBrainBridge.ts&#xa;OpenInExternalBrainButton.tsx&#xa;sender origin + schema 校验" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="145" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="p3-side" value="入口 2：Side Panel（待新增）&#xa;SidePanelApp.tsx&#xa;ConnectionGate.tsx&#xa;QuickAsk / TaskStatus" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="335" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="p3-work" value="入口 3：Workspace（待新增）&#xa;WorkspaceApp.tsx / Router.tsx&#xa;五 View + EvidenceDrawer&#xa;RecoveryBanner.tsx" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="525" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="p3-bg" value="Extension Background（待新增/唯一写入者）&#xa;entrypoints/background.ts&#xa;intentRouter.ts&#xa;workspaceTabManager.ts&#xa;idempotencyRegistry.ts&#xa;workspaceStateStore.ts&#xa;lifecycleAuditStore.ts" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="440" y="250" width="370" height="360" as="geometry"/></mxCell>
        <mxCell id="p3-contract" value="PX Core 合同（current→target）&#xa;current：intent/2 + command/1 + evidence/1 已开发&#xa;target：intent/3 + command/2 + lifecycle/3 + Chrome/2&#xa;runtime envelope / result / error 待新增&#xa;acceptance manifest/report/2 留 PX-6&#xa;API/状态/安全决策见运行时合同" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=11;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=12;" vertex="1" parent="1"><mxGeometry x="440" y="675" width="370" height="190" as="geometry"/></mxCell>
        <mxCell id="p3-contract-stop" value="合同迁移失败停止（对应第 6 页 p6-stop）&#xa;schema / validator / fixture / types 必须原子一致&#xa;Host view_source、Ask question、eventType、四视口任一负例失败&#xa;→ routeAAdrStatus=RETURN_TO_ADR；禁止进入 PX-2" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;fontColor=#6b1d1a;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="780" width="300" height="180" as="geometry"/></mxCell>
        <mxCell id="p3-api" value="FAMS Extension Adapter（待新增）&#xa;src/adapters/fams/FamsApiClient.ts&#xa;FamsDomainAdapter.ts&#xa;Background 唯一网络访问&#xa;GET 有限重试；POST Ask 自动重试=0" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="370" height="260" as="geometry"/></mxCell>
        <mxCell id="p3-facade" value="FAMS 有界 Query/Ask（待新增）&#xa;routes/externalBrain.ts + types&#xa;externalBrainReadService.ts&#xa;externalBrainAskService.ts + Policy.ts&#xa;Read 只读；Ask 不自动确认/交易" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="900" y="570" width="370" height="240" as="geometry"/></mxCell>
        <mxCell id="p3-services" value="现有 FAMS 业务服务（已开发/权威事实）&#xa;famsChatService&#xa;dailyReviewService&#xa;operationService&#xa;dailyReviewWorkflowService" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="1370" y="250" width="350" height="230" as="geometry"/></mxCell>
        <mxCell id="p3-data" value="现有数据/证据（已开发）&#xa;Prisma Operation / Daily Review&#xa;Position / Market bars&#xa;artifactRefs / workflow DAG&#xa;extension 不复制为业务真相" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="1370" y="570" width="350" height="240" as="geometry"/></mxCell>
        <mxCell id="p3-evidence" value="验收层（待新增）&#xa;Playwright + Chrome CDP&#xa;截图 / trace / lifecycle event&#xa;artifact SHA-256 + commit SHA&#xa;semantic validator：缺失/篡改/少视口 hard fail&#xa;.verification/private/v2-px/**" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="900" y="870" width="820" height="150" as="geometry"/></mxCell>
        <mxCell id="p3-e1" value="外部消息" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p3-host" target="p3-bg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e2" value="命令/订阅" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p3-side" target="p3-bg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e3" value="命令/订阅" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p3-work" target="p3-bg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e4" value="校验" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p3-contract" target="p3-bg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e5" value="Query/Ask 命令" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p3-bg" target="p3-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e6" value="HTTP read/controlled ask" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p3-api" target="p3-facade"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e7" value="编排复用" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p3-facade" target="p3-services"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e8" value="读取权威事实" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p3-services" target="p3-data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-e9" value="导出脱敏证据" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p3-bg" target="p3-evidence"><mxGeometry relative="1" as="geometry"/></mxCell>
