  <diagram id="v2px-page-4" name="4 三入口五Intent与目标原型">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p4-title" value="目标用户路径：三入口共享同一任务，Side Panel 简明，Workspace 完整" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p4-entry1" value="入口 A（已实现）&#xa;Chrome Side Panel&#xa;查看来源 / 打开工作台 / 在工作台定位" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="p4-entry2" value="入口 B（已实现）&#xa;独立 Workspace Page&#xa;直接切换五类视图/定位当前对象" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="p4-entry3" value="入口 C（已实现）&#xa;FAMS ChatBox / 复盘 / 任务中心&#xa;只发 intent route + 受控 ID&#xa;3000 allow / 3001 deny；PX4B PASS" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=12;" vertex="1" parent="1"><mxGeometry x="50" y="450" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="p4-route" value="Background 路由/命令（已实现，压力矩阵待补）&#xa;target intent/3 只导航&#xa;command/2 query 才携带问题&#xa;workspace/canonical/correlation 同语义&#xa;新动作 routeId 独立；ledger 去重" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="440" y="230" width="340" height="280" as="geometry"/></mxCell>
        <mxCell id="p4-sidewire" value="Side Panel 360/420 目标原型&#xa;┌ FAMS 外部大脑 · 已连接 ┐&#xa;│ 当前任务 + 数据时间      │&#xa;│ 简明结论（最多 5 行）    │&#xa;│ 查看依据                  │&#xa;│ 在完整工作台打开          │&#xa;│ 快速提问 + 最近任务       │&#xa;└ 不放大型图表/完整 DAG ┘" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="675" width="730" height="290" as="geometry"/></mxCell>
        <mxCell id="p4-i1" value="来源库 source_library&#xa;Operation artifact + Review evidence 索引" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="130" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-i2" value="来源详情 source_detail&#xa;来源/时间/可信状态/关联任务" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="250" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-i3" value="问答 ask&#xa;Route=进入 Ask View；Command=提交问题&#xa;famsChatService 结构化摘要 + fallback" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="370" width="390" height="110" as="geometry"/></mxCell>
        <mxCell id="p4-i4" value="追踪 trace&#xa;Operation timeline + task/artifact" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="490" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-i5" value="图谱 graph&#xa;Daily Review DAG + evidence 关系" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;fillColor=#fff0e1;strokeColor=#c96820;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="610" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="p4-workwire" value="Workspace 768/1280 目标原型&#xa;┌ 工作区身份 · 已恢复 · 研究模式 ┐&#xa;│ 左侧：五类视图 / 最近任务       │&#xa;│ 主区：结论摘要 + 当前视图       │&#xa;│ 图表 / 时间线 / DAG / 来源详情  │&#xa;│ 底部：默认折叠证据抽屉          │&#xa;└ 失败时 RecoveryBanner + 下一步 ┘" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="180" width="420" height="400" as="geometry"/></mxCell>
        <mxCell id="p4-states" value="六状态验收（两容器都必须有）&#xa;未连接 / 加载 / 空 / 失败 / 恢复 / 阻断&#xa;每种状态包含：原因 + 当前事实 + 下一步&#xa;禁止空白页、原始 HTTP 异常或伪 success" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="650" width="420" height="240" as="geometry"/></mxCell>
        <mxCell id="p4-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p4-entry1" target="p4-route"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p4-entry2" target="p4-route"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p4-entry3" target="p4-route"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p4-e4" value="规范化 intent" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p4-route" target="p4-i3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e5" value="完整呈现" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p4-i3" target="p4-workwire"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e6" value="快速呈现" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p4-route" target="p4-sidewire"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e7" value="所有状态可理解" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p4-workwire" target="p4-states"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2px-page-5" name="5 权限状态数据与恢复边界">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p5-title" value="4000 最小权限 + Background 单写 + at-most-once + 可推导恢复" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p5-user" value="用户动作&#xa;点击“连接本地 FAMS”&#xa;看到权限用途和精确地址&#xa;允许或拒绝，不静默扩权" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="330" height="190" as="geometry"/></mxCell>
        <mxCell id="p5-perm" value="Manifest 合同（已实现/PX1）&#xa;required: sidePanel,tabs,storage&#xa;hostPermissions=[]（安装默认无）&#xa;optional host：仅 localhost/127.0.0.1:4000&#xa;external connect：仅 localhost/127.0.0.1:3000&#xa;禁止 remote code / all_urls 通配权限" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=14;" vertex="1" parent="1"><mxGeometry x="480" y="160" width="390" height="230" as="geometry"/></mxCell>
        <mxCell id="p5-bg" value="Background（开发中/单写者）&#xa;验证 sender/schema/policy&#xa;API caller=扩展 ID header allowlist&#xa;有 Web Origin 必须拒绝&#xa;GET 有限退避；POST Ask 重试=0&#xa;dispatched 未知→unknown_result" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="980" y="160" width="380" height="250" as="geometry"/></mxCell>
        <mxCell id="p5-fams" value="FAMS 后端（已开发基础/目标 facade）&#xa;Prisma 保存持仓/复盘/Operation/artifact&#xa;FAMS Chat 保存问答业务结果&#xa;目标 Read/Ask facade 只编排复用&#xa;Ask 禁止自动确认/交易" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="1450" y="160" width="310" height="250" as="geometry"/></mxCell>
        <mxCell id="p5-session" value="chrome.storage.session（基础已实现/PX3）&#xa;WorkspaceState / route / correlation&#xa;live container / lifecycle events&#xa;最多 20 workspace；事件最多 1000&#xa;background 单写已验证；完整 reload 恢复待 PX5" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="480" y="500" width="390" height="220" as="geometry"/></mxCell>
        <mxCell id="p5-local" value="chrome.storage.local（ledger 基础已实现/PX3）&#xa;恢复索引：20 条 / TTL 30 天&#xa;dispatch ledger：500 条 / TTL 24 小时&#xa;两库独立清理，不跨 TTL 误删&#xa;只存 digest/state/resultRef&#xa;完整 fault/reload/TTL 矩阵待 PX5" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="980" y="500" width="380" height="220" as="geometry"/></mxCell>
        <mxCell id="p5-flow" value="恢复/迁移状态机（待新增）&#xa;start → session；缺失→local 索引&#xa;background 重取 FAMS 业务事实&#xa;成功→resume；失败→blocked&#xa;已知版本显式迁移+事件&#xa;未知 major→blocked，禁止静默清空" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="330" height="290" as="geometry"/></mxCell>
        <mxCell id="p5-life" value="生命周期必须由事件推导&#xa;Side Panel：start/resume/reconnect/close&#xa;Workspace：start/resume/reconnect/close&#xa;Background：route/reconnect/blocked&#xa;汇总状态不能由报告自称" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="1450" y="500" width="310" height="240" as="geometry"/></mxCell>
        <mxCell id="p5-hard" value="安全和业务硬边界&#xa;secret/cookie/token 进入证据 = hard fail&#xa;未授权时 API 请求数 = 0；broker order 请求数 = 0&#xa;四项交易锁恒 false&#xa;公开 extension ID header 只阻断普通网页&#xa;不冒充本机进程认证或生产身份安全" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="480" y="820" width="880" height="210" as="geometry"/></mxCell>
        <mxCell id="p5-write-order" value="命令存储写入顺序（基础已实现，PX5 补全）&#xa;1 读→expiresAt 升序清理→LRU&#xa;2 prepared/dispatched 写入并回读&#xa;3 网络仅调用一次&#xa;4 completed 写入并回读&#xa;5 recoveryIndex→session event/WorkspaceState&#xa;完整 storage fault/reload 回读证据待 PX5" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=11;fontStyle=1;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="330" height="220" as="geometry"/></mxCell>
        <mxCell id="p5-e1" value="主动授权 4000" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p5-user" target="p5-perm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e2" value="授权后访问" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p5-perm" target="p5-bg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e3" value="Read / controlled Ask" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p5-bg" target="p5-fams"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e4" value="写 live state" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p5-bg" target="p5-session"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e5" value="写最小索引" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p5-bg" target="p5-local"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e6" value="恢复读取" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p5-flow" target="p5-session"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e7" value="导出事件" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p5-bg" target="p5-life"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e8" value="不可绕过" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p5-bg" target="p5-hard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e9" value="先持久化并回读" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;strokeWidth=2;" edge="1" parent="1" source="p5-bg" target="p5-write-order"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e10" value="ledger→recoveryIndex" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p5-write-order" target="p5-local"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e11" value="最后写事件/状态" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p5-write-order" target="p5-session"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2px-page-6" name="6 开发及验收计划">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p6-title" value="顺序开发：每阶段先产生用户结果和证据，再允许进入下一阶段" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p6-d0" value="D0 文档审计（已通过）&#xa;PRD 20/20 + 决策检查 40/40&#xa;API/消息/状态/权限/证据 target 合同 + 8 页图&#xa;独立审计问题已闭环；用户已批准方案 A&#xa;出门：允许按阶段硬门槛顺序实施" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=14;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="350" height="240" as="geometry"/></mxCell>
        <mxCell id="p6-px1" value="PX-1 可行性 Spike（自动化 PASS）&#xa;最小 WXT + 三 entrypoint&#xa;intent/3、command/2、lifecycle/3&#xa;optional 4000 + external connect 3000&#xa;真实 unpacked Chrome 与合同负例通过" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=14;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="360" height="250" as="geometry"/></mxCell>
        <mxCell id="p6-px2" value="PX-2 Bounded API + Workspace（自动化 PASS）&#xa;Read/Ask/Policy/FamsApiClient/Adapter&#xa;Workspace 五视图 + 六状态基础&#xa;用户效果：768/1280 读取真实 FAMS 结果&#xa;真实 API/SQLite/Chrome 验收通过" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=14;" vertex="1" parent="1"><mxGeometry x="920" y="150" width="360" height="250" as="geometry"/></mxCell>
        <mxCell id="p6-px3" value="PX-3 Side Panel + Host App（自动化 PASS）&#xa;360/420 快速入口与简明摘要&#xa;Host 只发 intent route + 受控 ID&#xa;ChatBox/复盘/Operation 三页真实跳转&#xa;正式权限点击留 PX6 人工体验" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=14;" vertex="1" parent="1"><mxGeometry x="1360" y="150" width="360" height="250" as="geometry"/></mxCell>
        <mxCell id="p6-px4" value="PX-4 Router + at-most-once（当前下一阶段）&#xa;已具备基础 route/tab/ledger&#xa;待完成 3×3 压力、20 次/多窗口、storage fault/reload&#xa;同 key dispatch=1；unknown 不自动重试&#xa;验收还需订单=0 与真实 Chrome 全矩阵" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="250" y="540" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="p6-px5" value="PX-5 生命周期与恢复（未开发）&#xa;Back/Forward/Refresh/关闭重开&#xa;FAMS 断连、background reconnect&#xa;extension reload/update + storage migration&#xa;用户效果：5 秒内状态可见，不承诺 LLM 完成&#xa;验收：100% 事件推导；未知版本不静默清空" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="700" y="540" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="p6-px6" value="PX-6 产品化候选（未开发）&#xa;Playwright + Chrome CDP&#xa;G1-G7 + JSON/HTML + 人工体验清单&#xa;四视口/隐私/防假绿全部通过&#xa;用户效果：可按 commit 复核完整体验&#xa;仍不开放生产交易或远程发布" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="1150" y="540" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="p6-stop" value="全阶段停止规则&#xa;用户已批准方案 A 的顺序开发&#xa;PX-1 技术可行性已通过&#xa;任一阶段证据/负例失败不得进入下一阶段&#xa;不得并行越级或扩大交易权限&#xa;不得用自动通过代替 PX6 人工体验核查" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="480" y="870" width="800" height="170" as="geometry"/></mxCell>
        <mxCell id="p6-e1" value="用户另行批准" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p6-d0" target="p6-px1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e2" value="技术验证 + 人工确认" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-px1" target="p6-px2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e3" value="Workspace 出门" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-px2" target="p6-px3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e4" value="双入口出门" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-px3" target="p6-px4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e5" value="路由/适配出门" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-px4" target="p6-px5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e6" value="恢复出门" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p6-px5" target="p6-px6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e7" value="任何失败" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p6-px5" target="p6-stop"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2px-page-7" name="7 项目里程碑风险与回退">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p7-title" value="M0-M6 里程碑：风险在最早可验证阶段关闭，失败可回退" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p7-m0" value="M0 文档评审（已通过）&#xa;20/20 追踪 + 40/40 决策 + 8 页图&#xa;独立审计问题闭环；方案 A 已批准" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-m1" value="M1 Route A 技术验证（PASS）&#xa;target v3/v2 合同迁移&#xa;真实 Chrome 双容器&#xa;4000 权限/CORS/证据通过" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=12;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-m2" value="M2 API + Workspace（PASS）&#xa;五端点同源/Policy&#xa;五视图/六状态基础&#xa;768/1280 真实 Chrome" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=12;" vertex="1" parent="1"><mxGeometry x="530" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-m3" value="M3 Side Panel + Host（PASS）&#xa;360/420 轻入口&#xa;Host App 三页面跳转&#xa;PX4B=a0758b4" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#e2f0d9;strokeColor=#4f8a3c;spacing=12;" vertex="1" parent="1"><mxGeometry x="770" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-m4" value="M4 Intent/Adapter Accepted&#xa;三入口五 intent&#xa;复用 FAMS 事实/幂等" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="1010" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-m5" value="M5 Lifecycle Accepted&#xa;必测恢复场景 100%&#xa;restored 或 blocked" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="1250" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-m6" value="M6 产品化候选&#xa;G1-G7 + HTML + 人工体验&#xa;本地候选，不是生产发布" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=12;" vertex="1" parent="1"><mxGeometry x="1490" y="140" width="270" height="150" as="geometry"/></mxCell>
        <mxCell id="p7-risk1" value="风险 R1：Side Panel/Workspace headless 自动化不可控&#xa;最早验证：M1 / PX-1&#xa;门槛：unpacked Chrome + CDP 真实 trace&#xa;失败：返回 ADR，评估 Web Workspace + launcher" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=13;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="p7-risk2" value="风险 R2：MV3 GET 无 Origin / CORS 不可用&#xa;真实 Chrome 已触发 PX3 合同重入&#xa;方案 A：X-FAMS-Extension-Id allowlist&#xa;无 Origin+正确 ID 放行；Web Origin 恒拒绝&#xa;失败：停 PX3；禁止缺 Origin 默认放行" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="490" y="390" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="p7-risk3" value="风险 R3：五 intent 与 FAMS API 粒度不匹配&#xa;最早验证：M2/M4&#xa;缓解：有界 Read/Ask facade，不复制 service&#xa;先修 facade mapping 与 contract test&#xa;仍失败：进入下方红色回退路径" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="920" y="390" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="p7-risk4" value="风险 R4：状态漂移/重复副作用/隐私泄露&#xa;最早验证：M1/M4/M5&#xa;缓解：单写 + local ledger + 私有 evidence&#xa;POST 自动重试=0；unknown 不报 success&#xa;失败：对应阶段 hard fail，不进入 M6" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="1350" y="390" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="p7-review" value="每个里程碑的评审对象&#xa;用户可见结果 + 实际代码实体 + 自动测试 + 原始证据 + 失败归属&#xa;只有前一里程碑全部通过且需要的人工确认完成，后一里程碑才可开始" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="250" y="700" width="850" height="180" as="geometry"/></mxCell>
        <mxCell id="p7-hard" value="不会被 M6 自动解除的边界&#xa;生产身份/远程 origin/商店发布另立项目&#xa;正式交易、自动交易和券商 adapter 继续禁止&#xa;自动验收不能替代人类最终体验结论" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="1160" y="700" width="580" height="180" as="geometry"/></mxCell>
        <mxCell id="p7-r3-return" value="R3 回退：修 facade 后仍无法满足真实 read model → 返回运行时 API 合同/ADR，缩小 read model；禁止改 intent 名称、复制业务计算或用 mock 出门" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=11;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;fontColor=#6b1d1a;spacing=10;" vertex="1" parent="1"><mxGeometry x="920" y="620" width="390" height="70" as="geometry"/></mxCell>
        <mxCell id="p7-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p7-m0" target="p7-m1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-m1" target="p7-m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-m2" target="p7-m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-m3" target="p7-m4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-m4" target="p7-m5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-m5" target="p7-m6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e7" value="共同评审" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p7-m4" target="p7-review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e8" value="仍受约束" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p7-m6" target="p7-hard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p7-e9" value="字段映射仍失败" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;strokeWidth=2;" edge="1" parent="1" source="p7-risk3" target="p7-r3-return"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="v2px-page-8" name="8 验收门槛与出门条件">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p8-title" value="拒绝“三无验收”：每个场景都有前置条件、操作、阈值、证据和失败归属" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=24;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
        <mxCell id="p8-a1" value="AC01 首次连接（PX-1）&#xa;前置：FAMS 3000/4000 已启动、未授权&#xa;操作：Side Panel 点击连接→只确认 4000&#xa;阈值：未授权请求=0；/health=200&#xa;3000 只 external connect；无 all_urls 通配权限&#xa;证据：manifest/permission/network audit" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=11;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="410" height="190" as="geometry"/></mxCell>
        <mxCell id="p8-a2" value="AC02-04 提问/复用/Host 跳转（部分 PASS）&#xa;已通过：Side Panel 提问、Host 三页、重复 tab=1、1 秒 ack&#xa;PX4 待验：同 key 重放；20 次/多窗口；3×3 全矩阵&#xa;出门阈值：dispatch=1；POST retry=0；tab=1&#xa;三入口 canonical/correlation 一致；伪成功=0&#xa;证据：360/420 + command/entry/tab trace" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=11;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=12;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="410" height="200" as="geometry"/></mxCell>
        <mxCell id="p8-a3" value="AC05-06 五 intent + 四视口（PX-2/4）&#xa;前置：存在 artifact/review/operation&#xa;操作：逐个打开五视图；运行 360/420/768/1280&#xa;阈值：5/5 真实 read model；scrollWidth&lt;=clientWidth；console error=0&#xa;证据：intent audit + 四视口截图 + DOM audit" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=12;" vertex="1" parent="1"><mxGeometry x="920" y="130" width="410" height="190" as="geometry"/></mxCell>
        <mxCell id="p8-a4" value="AC07 生命周期（PX-5）&#xa;操作：Back/Forward/Refresh/重开/断连/reload/未知 storage major&#xa;阈值：5 秒内状态可见；restored/recovering/blocked&#xa;100% 由事件推导；未知版本不静默清空&#xa;证据：lifecycle/storage events + Chrome trace" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=11;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=12;" vertex="1" parent="1"><mxGeometry x="1360" y="130" width="400" height="200" as="geometry"/></mxCell>
        <mxCell id="p8-a5" value="AC08 六状态降级（PX-2/3/5）&#xa;操作：触发未连接/加载/空/失败/恢复/阻断&#xa;阈值：6/6 有原因和下一步；伪 success=0&#xa;证据：state matrix audit + 截图&#xa;失败归属：产生状态的最早阶段" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=12;" vertex="1" parent="1"><mxGeometry x="170" y="370" width="450" height="180" as="geometry"/></mxCell>
        <mxCell id="p8-a6" value="AC09 隐私和交易边界（全阶段）&#xa;操作：运行全路径并扫描 evidence/network/UI&#xa;阈值：secret/cookie/token/账户原图=0；broker order 请求=0；四锁恒 false&#xa;证据：redaction + trade boundary audit&#xa;失败归属：hard fail，禁止进入下一阶段" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=12;" vertex="1" parent="1"><mxGeometry x="675" y="370" width="450" height="180" as="geometry"/></mxCell>
        <mxCell id="p8-a7" value="AC10 防假绿（PX-6/来源阶段）&#xa;操作：删截图/改 hash/换 mock URL/事件乱序&#xa;再注入版本漂移、unknown→success、3000 host permission&#xa;阈值：全部负例失败；正例通过；commit 可复核&#xa;证据：negative fixtures + G1-G7 audit&#xa;失败归属：PX-6 或产生坏证据的阶段" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=11;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=12;" vertex="1" parent="1"><mxGeometry x="1180" y="370" width="450" height="190" as="geometry"/></mxCell>
        <mxCell id="p8-doc" value="已完成阶段出门：PX1～PX4B&#xa;PRD/traceability=20/20；决策=40/40&#xa;8 页中文图 + target 合同已对齐&#xa;真实双容器 + Host 三页 Chrome/DB/API 通过&#xa;隐私、交易零请求与负例无假绿&#xa;当前只允许进入 PX4 Router/幂等入口审计" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=12;fontStyle=1;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="80" y="650" width="500" height="260" as="geometry"/></mxCell>
        <mxCell id="p8-px" value="V2-PX 最终候选出门（尚未完成）&#xa;当前已到 PX4B；仍需 Router/幂等、恢复、PX6&#xa;真实双容器 Chrome acceptance 通过&#xa;G1-G7 全绿 + 人工体验核查通过&#xa;四视口/隐私/恢复/幂等全部达到阈值&#xa;最多声明 v2PxProductizationCandidate=true" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="650" y="650" width="500" height="250" as="geometry"/></mxCell>
        <mxCell id="p8-hard" value="始终不能由上述出门自动推出&#xa;implementationApprovalStatus 由用户明确指令改变&#xa;生产身份/远程 origin/Chrome Store 发布&#xa;正式交易、自动交易、订单创建&#xa;生产 broker adapter 启用&#xa;自动化不能代替人类最终决定" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="1220" y="650" width="500" height="250" as="geometry"/></mxCell>
        <mxCell id="p8-approval" value="当前审批状态：已批准 PX1～PX6 按硬门槛顺序自动开发&#xa;px1FeasibilitySpikeAllowed=true　中间门槛自动推进　PX6 最终人工体验确认保留" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=16;fontStyle=1;fillColor=#e2f0d9;strokeColor=#4f8a3d;" vertex="1" parent="1"><mxGeometry x="370" y="950" width="1060" height="70" as="geometry"/></mxCell>
        <mxCell id="p8-e1" value="文档通过后请求批准" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p8-doc" target="p8-approval"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e2" value="另行批准且逐阶段完成" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p8-approval" target="p8-px"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e3" value="不可推导" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p8-px" target="p8-hard"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
