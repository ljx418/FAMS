  <diagram id="ftr-batch-1" name="1 当前基线与阶段目标"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="p1-title" value="FAMS 当前状态：FTR 与投资工作流自动范围已闭环，PRD 全量仍未出门" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=26;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
    <mxCell id="p1-legend" value="绿=已实现并自动验收　黄=已实现但业务证据不足　橙=本阶段待开发/外部输入　蓝=审计产物　红=禁止与打回" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fillColor=#f3f4f6;strokeColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1720" height="50" as="geometry"/></mxCell>
    <mxCell id="p1-current" value="已实现基线&#xa;ChatBox + 普通工作台 + 专家多页&#xa;资产 Excel / Daily Review / RRG / 红利低波&#xa;FTR Service 链 + ExecutionIsolationService&#xa;investmentWorkflow.ts + 三类策略 Service&#xa;/backtest 统一复盘；旧组合对比路由兼容" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="420" height="310" as="geometry"/></mxCell>
    <mxCell id="p1-risk" value="当前真实状态&#xa;A0/FTR-1..6 自动验收通过（provisional）&#xa;投资工作流 WF-0..7：18/20 自动范围通过&#xa;真实账户 16 持仓 / 57 流水 / 16 归类待确认&#xa;动态 point_in_time_simulation 尚未实现并明确 blocked&#xa;FTR 队列 8 pending / 0 approved；PX6-02=0/10&#xa;生产适配器=disabled；四项交易锁=false" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="560" y="230" width="420" height="330" as="geometry"/></mxCell>
    <mxCell id="p1-plan" value="剩余出门路径&#xa;集中人工：A6 8 类 / 32 步 + 投资工作流截图纠错和归类确认&#xa;V2-PX 4 步必须真实 Chrome 现场采证&#xa;产品开发：另立阶段实现冻结策略逐日动态重算&#xa;任一否决按 rollbackStage 打回并失效下游证据&#xa;全部人工通过后才允许 A7 按同一哈希重建 final review package&#xa;任何工作台不得自签、补签授权或解锁交易" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="1050" y="230" width="420" height="380" as="geometry"/></mxCell>
    <mxCell id="p1-result" value="目标体验&#xa;普通用户：基本信息确认 → 仓位策略 → 回测复盘&#xa;研究用户：真实 total-return + OOS/WF/敏感性&#xa;审核用户：冻结证据队列、策略归类与截图事实均可核验&#xa;审计用户：从 HTML 回到代码、API、artifact 和截图" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="560" y="650" width="500" height="260" as="geometry"/></mxCell>
    <mxCell id="p1-hard" value="独立未来高风险阶段&#xa;productionAdapterEnabled=false&#xa;formalTradingUnlocked=false&#xa;autoTradeUnlocked=false&#xa;canCreateOrder=false&#xa;orderCreateAllowed=false&#xa;ADD / REDUCE / ORDER_CREATE / AUTO_TRADE blocked" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="1170" y="650" width="520" height="260" as="geometry"/></mxCell>
    <mxCell id="p1-e1" value="事实" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p1-current" target="p1-risk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1-e2" value="按门禁推进" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p1-risk" target="p1-plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1-e3" value="完成后" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p1-plan" target="p1-result"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1-e4" value="仍不解锁" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p1-result" target="p1-hard"><mxGeometry relative="1" as="geometry"/></mxCell>
