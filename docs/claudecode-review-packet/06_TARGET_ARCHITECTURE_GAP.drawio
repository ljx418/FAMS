  <diagram id="ftr-batch-8" name="8 出门门槛与独立解锁阶段"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="p8-title" value="出门条件：自动化绿、集中人工绿、交易锁仍红" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
    <mxCell id="p8-auto" value="自动化出门（当前文档支撑范围通过）&#xa;FTR-1/2/3 自动门槛通过；wf-04 失败保留&#xa;FTR-5 隔离与 FTR-6 28 artifact 哈希通过&#xa;投资工作流 WF-0..7 自动验收通过：18/20&#xa;账户事实保护、三视口和交易阻断通过&#xa;batchHumanReviewReady=true&#xa;evidence=provisional_until_human_pass" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="480" height="300" as="geometry"/></mxCell>
    <mxCell id="p8-human" value="集中人工与规格补齐出门（未完成）&#xa;A6：8 类 / 32 步；Daily UX + PX6-02 10/10 + data/benchmark/model/risk/compliance/final&#xa;投资工作流：截图纠错、16 项策略归类、人工计划/曲线语义/移动端体验&#xa;产品缺口：冻结策略版本的动态 point_in_time_simulation 需另阶段实现与验收&#xa;A7 只按同一哈希重建 final package&#xa;当前 humanAcceptanceStatus=pending_batch_review；四锁 false" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="660" y="190" width="480" height="320" as="geometry"/></mxCell>
    <mxCell id="p8-future" value="独立未来生产解锁阶段（本阶段不执行）&#xa;重新评估生产身份/券商适配器/资金风险&#xa;独立计划 + 独立人工批准 + 独立 E2E&#xa;此前 artifact 仅作输入，不能自动继承权限&#xa;未批准：productionAdapterEnabled=false" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="1250" y="190" width="480" height="300" as="geometry"/></mxCell>
    <mxCell id="p8-hard" value="Hard Fail / 拒绝声明全量完成&#xa;无真实数据或用 mock 替代&#xa;saved advice 冒充动态 point-in-time 重算&#xa;失败 candidate/insufficient/人工否决被隐藏&#xa;artifact hash 不一致或旧证据冒充本轮&#xa;自动化写入人工 passed；用户路径无操作/阈值/证据&#xa;任何交易锁为 true 或出现真实订单/持仓变化" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="70" y="610" width="530" height="280" as="geometry"/></mxCell>
    <mxCell id="p8-claims" value="当前可声明&#xa;automatedAcceptanceStatus=passed_supported_scope&#xa;investmentWorkflow=18/20；batchHumanReviewReady=true&#xa;formalTradingReleaseReviewReady=true&#xa;prdFullyComplete=false&#xa;finalFormalReleaseReviewPackageReady=false&#xa;&#xa;仍固定 false：formalTradingReleaseReady / formalTradingUnlocked / autoTradeUnlocked / canCreateOrder / orderCreateAllowed" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="700" y="610" width="500" height="280" as="geometry"/></mxCell>
    <mxCell id="p8-audit" value="人类审计入口&#xa;current-stage-state.json + PRD_COMPLETION_TRACEABILITY_MATRIX.md&#xa;INVESTMENT_WORKFLOW_UX_PRD.md + WF-7 report/matrix&#xa;DEFERRED_HUMAN_ACCEPTANCE_EXECUTION_PLAN.md&#xa;FTR manifest + 13-18 artifacts&#xa;read-drawio-output.txt + 综合 acceptance-report.html&#xa;能回答：做什么、如何操作、阈值、证据、未完成项和失败打回" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="1300" y="610" width="430" height="280" as="geometry"/></mxCell>
    <mxCell id="p8-e1" value="全绿后" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p8-auto" target="p8-human"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e2" value="另立项目并批准" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p8-human" target="p8-future"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e3" value="形成声明" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p8-human" target="p8-claims"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e4" value="违规打回" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p8-hard" target="p8-claims"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p8-e5" value="复核" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p8-claims" target="p8-audit"><mxGeometry relative="1" as="geometry"/></mxCell>
