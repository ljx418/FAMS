  <diagram id="ftr-batch-3" name="3 正式数据治理"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="p3-title" value="A0-A1：授权真实数据到字段级证据" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
    <mxCell id="p3-auth" value="A0 已通过　公开来源使用依据（不是后置签核）&#xa;本机/个人/非商业；不宣称商业授权&#xa;H00300 request + factsheet + methodology + raw SHA-256&#xa;FormalProviderAuthorization v2 + endpoint allowlist&#xa;ReleaseCandidateSet 七策略 / default 用户 / immutable" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e7f4ea;strokeColor=#3f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="350" height="250" as="geometry"/></mxCell>
    <mxCell id="p3-provider" value="FormalDataProviderService（已实现并验收）&#xa;公开来源用途与 endpoint allowlist&#xa;live 缺失时仅允许同窗口哈希自证重放&#xa;保存 sourceEndpoint/fetchedAt/version/hash" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="350" height="230" as="geometry"/></mxCell>
    <mxCell id="p3-snapshot" value="FormalDataSnapshot v2（7/7 passed）&#xa;price / benchmark / dividend / tradeability&#xa;fundamental / industryClassification / costModel&#xa;49 字段 / 26 双源序列 / canonical SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="930" y="210" width="350" height="230" as="geometry"/></mxCell>
    <mxCell id="p3-validator" value="FormalDataFreshnessPolicy + FieldEvidenceValidator（已验收）&#xa;最近完成交易日/provider SLA&#xa;coverage >= 80%&#xa;cross-check + evidenceRefs + strict Schema&#xa;unknown/stale/blocked 不能 passed" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="1360" y="210" width="360" height="250" as="geometry"/></mxCell>
    <mxCell id="p3-user" value="用户验收路径&#xa;Backtest 选 candidate -> 运行正式评审&#xa;逐字段看 provider/日期/覆盖/交叉校验&#xa;缺失项显示资产、窗口和恢复动作&#xa;Operations 打开同一 evidenceRefs" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="420" y="590" width="400" height="250" as="geometry"/></mxCell>
    <mxCell id="p3-evidence" value="FTR-1 provisional 证据&#xa;15_data_governance_audit.json&#xa;provider_authorization_audit.json&#xa;field_evidence_validation_audit.json&#xa;automated=passed / human=pending_batch_review" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="900" y="590" width="400" height="250" as="geometry"/></mxCell>
    <mxCell id="p3-hard" value="Hard Fail&#xa;免费源冒充 official&#xa;secret 进入日志/浏览器/artifact&#xa;stale/unknown 被隐藏&#xa;LLM fallback 冒充 passed&#xa;Web Origin 代替 Extension identity" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="1400" y="590" width="320" height="250" as="geometry"/></mxCell>
