    <mxCell id="p4-title" value="A2-A3：可信 Total Return Benchmark 与 Formal Validation" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
    <mxCell id="p4-import" value="可信 Benchmark 输入&#xa;中证指数公开 H00300 沪深300全收益&#xa;本机非商业 trust decision → trusted_total_return&#xa;source terms/request/points/sourceRefs/contentHash/replay&#xa;不得宣称商业授权或 official_total_return；旧价格收益 proxy 禁止判绿" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="400" height="240" as="geometry"/></mxCell>
    <mxCell id="p4-bench" value="FormalBenchmarkService（FTR-2 已验收）&#xa;importBenchmark：H00300 版本化不可变导入&#xa;qualificationAudit：用途/授权/日期/证据/alias&#xa;buildSeries：735 点按日期精确回放&#xa;二次运行 idempotent=true" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="540" y="190" width="400" height="240" as="geometry"/></mxCell>
    <mxCell id="p4-input" value="FormalValidationProfileSet（已冻结并验收）&#xa;七对象 inventory=7，不删除失败结果&#xa;红利低波：product_release_candidate + equity_selection_release_v1 + H00300&#xa;永久/全天候：research_reference&#xa;当前持仓：diagnostic；本地样本：engineering&#xa;not_applicable 不得冒充 passed" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="1010" y="190" width="400" height="240" as="geometry"/></mxCell>
    <mxCell id="p4-validation" value="FormalValidationService（FTR-3 v2 自动验收通过）&#xa;免费来源 5216/5216；六冻结时点 6/6 ready&#xa;红利低波 OOS/WF/5 参数重放为 5/6；53 paths；分组 6/3/3&#xa;wf-04 failed 保留，人工模型复核 pending&#xa;&#xa;注意：这不等于建议级 point_in_time_simulation 已实现；ScenarioComparisonService 的冻结策略逐日动态重算仍 blocked" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="1340" y="500" width="390" height="300" as="geometry"/></mxCell>
    <mxCell id="p4-threshold" value="冻结硬门槛（仅适用产品候选）&#xa;releaseEffectivePathCount >= 30；tradeability >= 80%&#xa;sample >= 60 日；max drawdown >= -35%&#xa;industry/market/liquidity groups >= 3&#xa;walkForwardWindows >= 6；passedRatio >= 0.6&#xa;testedParameterSets >= 5；stableRatio >= 0.6&#xa;annual turnover &lt;= 200%&#xa;return spread &lt;= 15pp；drawdown spread &lt;= 10pp&#xa;allReleaseCandidatesPassed=true" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="850" y="540" width="400" height="300" as="geometry"/></mxCell>
    <mxCell id="p4-output" value="provisional artifacts&#xa;16_benchmark_qualification_audit.json&#xa;benchmark_total_return_replay.json&#xa;17_formal_validation_audit.json&#xa;release_candidate_set.json&#xa;humanAcceptanceStatus=pending_batch_review" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="380" y="560" width="390" height="260" as="geometry"/></mxCell>
    <mxCell id="p4-user" value="用户操作&#xa;Backtest 选择建议复盘或组合回测&#xa;saved advice：按建议 / 不执行 / 实际流水同一冻结时间轴&#xa;正式验证：策略/benchmark 的 OOS/WF/参数/分组&#xa;动态逐日重算未实现时必须显示 insufficient，不得借 saved replay 冒充" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="540" width="280" height="290" as="geometry"/></mxCell>
    <mxCell id="p4-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p4-import" target="p4-bench"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6b7280;" edge="1" parent="1" source="p4-bench" target="p4-input"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p4-input" target="p4-validation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p4-validation" target="p4-threshold"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p4-threshold" target="p4-output"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p4-output" target="p4-user"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="ftr-batch-5" name="5 集中人工核查与证据失效"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="p5-title" value="A4-A7：Provisional 证据、集中人工核查、Final 评审包" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
    <mxCell id="p5-auto" value="A0-A5 自动产物状态&#xa;FTR-1 data / FTR-2 benchmark / FTR-3 validation=passed（provisional）&#xa;FTR-3 v2=5/6、53 paths；wf-04 failed 保留&#xa;FTR-5 execution isolation=passed&#xa;FTR-6 覆盖 A0/FTR-1..5 与 28 个来源 artifact&#xa;全部哈希逐字节验证；人工状态仍 pending&#xa;生产适配器与四项交易锁未放行" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="380" height="270" as="geometry"/></mxCell>
    <mxCell id="p5-queue" value="DeferredHumanReviewQueueService（已实现）&#xa;FTR 队列 8 项：Daily UX / V2-PX / data / benchmark / model / risk / compliance / final&#xa;当前 8 pending / 0 approved；artifactRefs + SHA-256 + rollbackStage&#xa;投资工作流另有截图逐行纠错、16 项策略归类与语义可读性集中核验，不得混写为 FTR 已签核&#xa;自动化不得写 passed" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="450" height="290" as="geometry"/></mxCell>
    <mxCell id="p5-review" value="A6 图文工作台（工程已实现 / 人工仍 pending）&#xa;formal-release-human-checklist.html：8 类 / 32 步 / 32 图&#xa;28 张真实运行或冻结证据图；V2-PX 4 张非证据操作示意&#xa;V2-PX 仍必须回填真实 Chrome 截图/trace&#xa;HumanAcceptanceDraftService：revision / package hash / secret/path gate&#xa;8/8 草稿只到 ready_for_authorized_signoff，不写正式签核&#xa;最终项审核 FTR-6 provisional 包并只批准 A7 生成" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="1020" y="210" width="420" height="310" as="geometry"/></mxCell>
    <mxCell id="p5-final" value="A7 Final FormalReleaseReviewPackage（未准入）&#xa;仅在 A6 八项全部通过后执行&#xa;ReleaseGateService 只消费已签核的同一哈希&#xa;重建 14_release_gate_audit.json + HTML + SUMMARY&#xa;目标 finalFormalReleaseReviewPackageReady=true&#xa;当前仍为 false" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=top;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="600" width="410" height="250" as="geometry"/></mxCell>
    <mxCell id="p5-invalid" value="否决/变化后的失效链&#xa;Data 失败 -> FTR-2/3/6 invalidated&#xa;Benchmark 失败 -> FTR-3/6 invalidated&#xa;Model 失败 -> FTR-6 invalidated&#xa;Isolation 失败 -> 全部停止&#xa;任一 artifact hash 变化 -> 对应签核失效&#xa;保留失败证据，不得只改摘要" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="700" y="600" width="430" height="270" as="geometry"/></mxCell>
    <mxCell id="p5-provisional" value="A5 Provisional Package（已自动验收）&#xa;batchHumanReviewReady=true&#xa;formalTradingReleaseReviewReady=true&#xa;downstreamEvidenceStatus=provisional_until_human_pass&#xa;28 个来源 artifact 哈希通过&#xa;不得出现 final/approved/release passed" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="620" width="440" height="220" as="geometry"/></mxCell>
    <mxCell id="p5-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p5-auto" target="p5-queue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p5-queue" target="p5-review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e3" value="A5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p5-queue" target="p5-provisional"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e4" value="全通过" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p5-review" target="p5-final"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5-e5" value="任一失败" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p5-review" target="p5-invalid"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="ftr-batch-6" name="6 用户操作与验收路径"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="p6-title" value="四条真实用户路径：每条都有操作、结果、门槛和证据" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
    <mxCell id="p6-a-label" value="A 普通用户&#xa;真实资产到解释" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fillColor=#e8f5ec;strokeColor=#2f7d4a;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="220" height="170" as="geometry"/></mxCell>
    <mxCell id="p6-a-flow" value="1 Assets 选择同花顺/支付宝并上传截图或 Excel　→　2 逐行纠错确认并查看 provider/as-of/MA　→　3 Positions 查看系统归类理由并人工确认　→　4 进入轮动/红利/组合策略　→　5 Backtest 三场景复盘　→　6 ChatBox / Operations 查看解释与证据&#xa;&#xa;目标：六次主要操作内完成基本信息确认→仓位策略→回测复盘；未确认归类时诚实阻断。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cbd5e1;spacing=16;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="1000" height="170" as="geometry"/></mxCell>
    <mxCell id="p6-a-gate" value="出门门槛&#xa;真实账户事实不变；未确认项可恢复&#xa;三视口无溢出；订单=0&#xa;&#xa;证据：WF-7 18 截图 + 前后快照" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=middle;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="1390" y="150" width="360" height="170" as="geometry"/></mxCell>
    <mxCell id="p6-b-label" value="B 研究用户&#xa;策略正式验证" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fillColor=#e7f0f8;strokeColor=#315f8c;" vertex="1" parent="1"><mxGeometry x="50" y="365" width="220" height="170" as="geometry"/></mxCell>
    <mxCell id="p6-b-flow" value="1 选择真实 Advice/GridPlan 或冻结 candidate　→　2 saved replay 比较按建议/不执行/实际流水　→　3 正式链加载 authorized data 与 qualified benchmark　→　4 查看 OOS/WF/参数/分组、failed/insufficient 与 15-17 audit&#xa;&#xa;目标：每条曲线来自同一冻结输入；动态逐日重算未实现时明确阻断。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cbd5e1;spacing=16;" vertex="1" parent="1"><mxGeometry x="330" y="365" width="1000" height="170" as="geometry"/></mxCell>
    <mxCell id="p6-b-gate" value="出门门槛&#xa;30 paths；3 industries&#xa;6 windows；passed ratio ≥ 0.6&#xa;&#xa;证据：candidate + replay + validation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=middle;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="1390" y="365" width="360" height="170" as="geometry"/></mxCell>
    <mxCell id="p6-c-label" value="C 审核用户&#xa;集中人工核查" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fillColor=#fff4d6;strokeColor=#b7791f;" vertex="1" parent="1"><mxGeometry x="50" y="580" width="220" height="170" as="geometry"/></mxCell>
    <mxCell id="p6-c-flow" value="1 打开 A6 图文工作台并确认 FTR-6 package/hash　→　2 按 32 步配图完成产品 / 数据 / benchmark / 模型 / 风险 / 合规核查　→　3 回填实际结果、差异、复现、建议和私有证据路径　→　4 前七项通过后 final reviewer 审核 provisional 包并批准或打回&#xa;&#xa;目标结果：草稿不冒充签核；谁审了什么、基于哪份证据、失败后打回哪里均可追踪。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cbd5e1;spacing=16;" vertex="1" parent="1"><mxGeometry x="330" y="580" width="1000" height="170" as="geometry"/></mxCell>
    <mxCell id="p6-c-gate" value="出门门槛&#xa;8 项各一次；hash 一致&#xa;Agent 无签核权限&#xa;&#xa;证据：queue + 18 audit + HTML" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=middle;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="1390" y="580" width="360" height="170" as="geometry"/></mxCell>
    <mxCell id="p6-d-label" value="D 安全审计&#xa;交易动作阻断" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=17;fontStyle=1;fillColor=#fde8e7;strokeColor=#b43a36;" vertex="1" parent="1"><mxGeometry x="50" y="795" width="220" height="170" as="geometry"/></mxCell>
    <mxCell id="p6-d-flow" value="1 ChatBox / Backtest / API 请求禁止动作　→　2 Permission Gate 返回 blocked 与缺失门禁　→　3 Operations 核对无 order artifact 且持仓无变化&#xa;&#xa;目标结果：用户明确知道当前仅支持研究和草案，不会被误导为可下单。" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cbd5e1;spacing=16;" vertex="1" parent="1"><mxGeometry x="330" y="795" width="1000" height="170" as="geometry"/></mxCell>
    <mxCell id="p6-d-gate" value="出门门槛&#xa;ADD / REDUCE / ORDER_CREATE / AUTO_TRADE 全 blocked&#xa;&#xa;证据：13 audit + runtime + wording" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="1390" y="795" width="360" height="170" as="geometry"/></mxCell>
    <mxCell id="p6-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p6-a-label" target="p6-a-flow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p6-a-flow" target="p6-a-gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p6-b-label" target="p6-b-flow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p6-b-flow" target="p6-b-gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p6-c-label" target="p6-c-flow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p6-c-flow" target="p6-c-gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p6-d-label" target="p6-d-flow"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p6-e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b43a36;" edge="1" parent="1" source="p6-d-flow" target="p6-d-gate"><mxGeometry relative="1" as="geometry"/></mxCell>
  </root></mxGraphModel></diagram>
  <diagram id="ftr-batch-7" name="7 开发里程碑与打回"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="p7-title" value="A0-A7 两行主路径：顺序开发、自动验收、集中人工核查" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=25;fontStyle=1;align=left;fillColor=#17385b;strokeColor=#17385b;fontColor=#ffffff;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1720" height="70" as="geometry"/></mxCell>
    <mxCell id="p7-a0" value="A0 / M0　已通过 provisional&#xa;七对象 role/profile/component/benchmark 已冻结&#xa;候选 v2 与公开来源用途证据已绑定&#xa;输入变化将失效 FTR-1..6 下游证据" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;fillColor=#e4f3e8;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="360" height="145" as="geometry"/></mxCell>
    <mxCell id="p7-a1" value="A1 / M1　已通过 provisional&#xa;15 audit 已绑定 profileSetHash&#xa;5216/5216 标的；六冻结时点 6/6 ready&#xa;数据人工复核仍 pending" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;fillColor=#e4f3e8;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="500" y="170" width="360" height="145" as="geometry"/></mxCell>
    <mxCell id="p7-a2" value="A2 / M2　已通过 provisional&#xa;H00300 trusted total-return 已重放&#xa;16 audit 已绑定红利低波 benchmark map&#xa;候选失败不得更换 benchmark 求绿" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;fillColor=#e4f3e8;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="940" y="170" width="360" height="145" as="geometry"/></mxCell>
    <mxCell id="p7-a3" value="A3 / M3　已通过 provisional&#xa;FREE-P1=5216/5216；六时点=6/6 ready&#xa;FTR-3 v2=5/6、53 paths、分组 6/3/3&#xa;wf-04 failed 保留；模型人工复核 pending" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;fillColor=#e4f3e8;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="1380" y="170" width="360" height="145" as="geometry"/></mxCell>
    <mxCell id="p7-a4" value="A4 / M4　已自动验收&#xa;FTR-4 队列 8 pending / 0 approved&#xa;FTR-5 isolation regression passed&#xa;风险证据已重绑定；production adapter disabled" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="1380" y="390" width="360" height="145" as="geometry"/></mxCell>
    <mxCell id="p7-a5" value="A5 / M5　已自动验收&#xa;FTR-6 provisional package 覆盖 A0/FTR-1..5&#xa;28 个来源 artifact 逐字节哈希通过&#xa;batchHumanReviewReady=true；人工仍 pending" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;fillColor=#e8f5ec;strokeColor=#2f7d4a;spacing=14;" vertex="1" parent="1"><mxGeometry x="940" y="390" width="360" height="145" as="geometry"/></mxCell>
    <mxCell id="p7-a6" value="A6 / M6　工作台已实现，人工待执行&#xa;8 类 / 32 步 / 配图覆盖率 100%&#xa;28 张证据图 + 4 张非证据操作示意&#xa;V2-PX 仍须真实 Chrome 采证&#xa;私有草稿绑定 package hash 和 revision&#xa;8/8 后仍需授权签核；否决回责任阶段" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="500" y="390" width="360" height="170" as="geometry"/></mxCell>
    <mxCell id="p7-a7" value="A7 / M7　未准入&#xa;A6 全通过后重建 13/14 + HTML + SUMMARY&#xa;目标 finalFormalReleaseReviewPackageReady=true&#xa;当前 false；仍不解锁正式交易" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;fillColor=#fff0e1;strokeColor=#c96820;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="360" height="145" as="geometry"/></mxCell>
    <mxCell id="p7-doc" value="每阶段必须落盘&#xa;DEVELOPMENT_PLAN + ACCEPTANCE_PLAN + ENTRY_AUDIT&#xa;PRD_SPEC_REVIEW + JSON artifacts + failure/replan history&#xa;命令、输入版本、commit、artifact hash、失败责任人完整" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#e7f0f8;strokeColor=#315f8c;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="520" height="240" as="geometry"/></mxCell>
    <mxCell id="p7-auto" value="自动推进条件&#xa;A0-A5 与 WF-0..7 documented scope 均 passed；无 fatal / major 规格偏差&#xa;只用真实数据，不以 mock、fallback 或 timeout 冒充通过&#xa;投资工作流=18 PASS / 1 HUMAN_PENDING / 1 CONTROLLED_BLOCK&#xa;A6 与 V2-PX 人工状态保持 pending，不得自动转绿" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;align=left;verticalAlign=top;fillColor=#fff4d6;strokeColor=#b7791f;spacing=14;" vertex="1" parent="1"><mxGeometry x="640" y="680" width="500" height="240" as="geometry"/></mxCell>
    <mxCell id="p7-return" value="打回责任矩阵&#xa;授权 / 凭据 / 输入 → A0　　数据字段 → A1　　Benchmark → A2&#xa;Candidate / 统计 / 阈值 → A3　　权限漂移 / mutation → A4 并停止&#xa;Queue / hash / report → A5 或 A7　　人工否决 → 对应责任阶段" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=14;fontStyle=1;align=left;verticalAlign=top;fillColor=#fde8e7;strokeColor=#b43a36;spacing=14;" vertex="1" parent="1"><mxGeometry x="1200" y="680" width="540" height="240" as="geometry"/></mxCell>
    <mxCell id="p7-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-a0" target="p7-a1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p7-a1" target="p7-a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b7791f;" edge="1" parent="1" source="p7-a2" target="p7-a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p7-a3" target="p7-a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#315f8c;" edge="1" parent="1" source="p7-a4" target="p7-a5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#c96820;" edge="1" parent="1" source="p7-a5" target="p7-a6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p7-e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2f7d4a;" edge="1" parent="1" source="p7-a6" target="p7-a7"><mxGeometry relative="1" as="geometry"/></mxCell>
