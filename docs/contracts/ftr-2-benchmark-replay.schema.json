{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fams.local/schemas/ftr-2-benchmark-replay.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "benchmarkId", "version", "benchmarkType", "provider", "licenseRef", "currency", "points", "sourceRefs", "contentHash", "importedAt", "importedByUserId", "importedByEmail", "immutable"],
  "properties": {
    "schemaVersion": {"const": "fams.formal_benchmark.import.v1"},
    "benchmarkType": {"enum": ["official_total_return", "trusted_total_return"]},
    "points": {"type": "array", "minItems": 2},
    "sourceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "immutable": {"const": true}
  }
}
