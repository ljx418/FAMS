{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fams.local/schemas/ftr-a0-validation-profile-set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "setVersion", "candidateSet", "ownerDecisionRef", "inventoryCount", "productReleaseCandidateIds", "candidateAssignments", "profileSetHash", "frozen", "generatedAt"],
  "properties": {
    "schemaVersion": {"const": "fams.formal_validation_profile_set.v1"},
    "setVersion": {"type": "string", "minLength": 1},
    "candidateSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setId", "version", "contentHash"],
      "properties": {
        "setId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "ownerDecisionRef": {"const": "project-owner-conversation:2026-09-14:route-a-with-candidate-benchmark-mapping"},
    "inventoryCount": {"const": 7},
    "productReleaseCandidateIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidateAssignments": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "candidateVersion", "candidateRole", "validationProfileId", "formalGateApplicable", "benchmarkId", "componentIds", "definitionHash", "exclusionReason", "componentSelectionMode", "selectionArtifactRef", "selectionArtifactSha256"],
        "properties": {
          "candidateId": {"type": "string", "minLength": 1},
          "candidateVersion": {"type": "string", "minLength": 1},
          "candidateRole": {"enum": ["product_release_candidate", "research_reference_strategy", "diagnostic_snapshot", "engineering_path_fixture"]},
          "validationProfileId": {"enum": ["equity_selection_release_v1", "strategic_allocation_reference_v1", "current_holdings_diagnostic_v1", "engineering_path_only_v1"]},
          "formalGateApplicable": {"type": "boolean"},
          "benchmarkId": {"type": ["string", "null"]},
          "componentIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "definitionHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "exclusionReason": {"type": ["string", "null"]}
          ,"componentSelectionMode": {"enum": ["fixed_definition", "point_in_time_dynamic"]}
          ,"selectionArtifactRef": {"type": ["string", "null"]}
          ,"selectionArtifactSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "profileSetHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "frozen": {"const": true},
    "generatedAt": {"type": "string", "format": "date-time"}
  }
}
