{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fams.local/schemas/deferred-human-review-queue.schema.json",
  "title": "FAMS Deferred Human Review Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "commitSha", "commitShaRole", "gitEvidenceStatus", "worktreeSnapshotHash", "sourceManifest", "executionMode", "automationSelfApprovalAllowed", "humanAcceptanceStatus", "batchHumanReviewReady", "manualSignoffPassed", "items", "formalTradingUnlocked", "autoTradeUnlocked", "canCreateOrder", "orderCreateAllowed"],
  "properties": {
    "schemaVersion": {"const": "fams.deferred_human_review_queue.v2"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "commitShaRole": {"const": "base_commit_not_artifact_claim"},
    "gitEvidenceStatus": {"enum": ["clean_commit", "uncommitted_worktree_snapshot"]},
    "worktreeSnapshotHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceManifest": {"$ref": "#/$defs/artifactRef"},
    "executionMode": {"const": "batch_after_automated_scope"},
    "automationSelfApprovalAllowed": {"const": false},
    "humanAcceptanceStatus": {"const": "pending_batch_review"},
    "batchHumanReviewReady": {"const": true},
    "manualSignoffPassed": {"const": false},
    "formalTradingUnlocked": {"const": false},
    "autoTradeUnlocked": {"const": false},
    "canCreateOrder": {"const": false},
    "orderCreateAllowed": {"const": false},
    "items": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "allOf": [
        {"contains": {"properties": {"reviewType": {"const": "daily_user_experience"}}, "required": ["reviewType"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"reviewType": {"const": "v2_px_experience"}}, "required": ["reviewType"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"reviewType": {"const": "data"}}, "required": ["reviewType"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"reviewType": {"const": "benchmark"}}, "required": ["reviewType"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"reviewType": {"const": "model"}}, "required": ["reviewType"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"reviewType": {"const": "risk"}}, "required": ["reviewType"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"reviewType": {"const": "compliance"}}, "required": ["reviewType"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"reviewType": {"const": "final_release"}}, "required": ["reviewType"]}, "minContains": 1, "maxContains": 1}
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewId", "reviewType", "sourceEvidenceStatus", "status", "artifactRefs", "artifactHashes", "rollbackStage", "reviewer", "reviewedAt", "blockers"],
        "properties": {
          "reviewId": {"type": "string", "pattern": "^ftr4-[a-z0-9_-]+-[a-f0-9]{12}$"},
          "reviewType": {"enum": ["daily_user_experience", "v2_px_experience", "data", "benchmark", "model", "risk", "compliance", "final_release"]},
          "sourceEvidenceStatus": {"enum": ["automated_pass_human_pending", "automated_pass_rebind_after_ftr5", "pending_final_package"]},
          "status": {"const": "pending"},
          "artifactRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "artifactHashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
          "rollbackStage": {"enum": ["UX", "V2-PX-PX6-02", "FTR-1", "FTR-2", "FTR-3", "FTR-5", "FTR-6"]},
          "reviewer": {"type": "null"},
          "reviewedAt": {"type": "null"},
          "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
