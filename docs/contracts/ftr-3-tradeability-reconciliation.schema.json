{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fams.local/schemas/ftr-3-tradeability-reconciliation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stageId", "status", "candidateId", "validationProfileId", "ftr1SourceEvidencePath", "componentIds", "windowIds", "denominatorDefinition", "requiredPathCount", "coveredPathCount", "coveragePercent", "paths", "barPresenceVolumeReconstructionOnly", "exchangeOrderBookStatusClaimed", "inputHash", "realDataUsed", "notTradingAdvice"],
  "properties": {
    "schemaVersion": {"const": "fams.ftr_3.tradeability_reconciliation.v1"},
    "stageId": {"const": "FTR-3"},
    "status": {"const": "passed"},
    "candidateId": {"const": "dividend_low_vol_basket"},
    "validationProfileId": {"const": "equity_selection_release_v1"},
    "ftr1SourceEvidencePath": {"type": "string", "minLength": 1},
    "componentIds": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{6}$"}},
    "windowIds": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "pattern": "^wf-[0-9]{2}$"}},
    "denominatorDefinition": {"const": "frozen_candidate_component_x_frozen_validation_window"},
    "requiredPathCount": {"type": "integer", "minimum": 30},
    "coveredPathCount": {"type": "integer", "minimum": 30},
    "coveragePercent": {"type": "number", "minimum": 80, "maximum": 100},
    "paths": {"type": "array", "minItems": 30, "items": {"type": "object", "additionalProperties": false, "required": ["symbol", "windowId", "requiredPoints", "coveredPoints", "coveragePercent", "status", "evidenceRef"], "properties": {"symbol": {"type": "string", "pattern": "^[0-9]{6}$"}, "windowId": {"type": "string"}, "requiredPoints": {"const": 60}, "coveredPoints": {"type": "integer", "minimum": 48}, "coveragePercent": {"type": "number", "minimum": 80}, "status": {"const": "passed"}, "evidenceRef": {"type": "string", "minLength": 1}}}},
    "barPresenceVolumeReconstructionOnly": {"const": true},
    "exchangeOrderBookStatusClaimed": {"const": false},
    "inputHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "realDataUsed": {"const": true},
    "notTradingAdvice": {"const": true}
  }
}
