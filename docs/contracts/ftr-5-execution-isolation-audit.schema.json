{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fams.local/schemas/ftr-5-execution-isolation-audit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "sourceChain", "status", "mode", "paperTradingReady", "sandboxReady", "productionAdapterEnabled", "realPositionMutationAllowed", "orderCreateAllowed", "canCreateOrder", "formalTradingUnlocked", "autoTradeUnlocked", "intents", "blockers", "warnings", "evidenceRefs", "protectedAccountDigestBefore", "protectedAccountDigestAfter", "accountFactsUnchanged", "notTradingAdvice"],
  "properties": {
    "schemaVersion": {"const": "portfolio.execution_isolation_audit.v1"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "sourceChain": {"type": "object", "additionalProperties": false, "required": ["ftr3FormalValidation", "ftr4ReviewQueue"], "properties": {"ftr3FormalValidation": {"$ref": "#/$defs/artifactRef"}, "ftr4ReviewQueue": {"$ref": "#/$defs/artifactRef"}}},
    "status": {"const": "ready_for_paper_review"},
    "mode": {"const": "paper_sandbox_only"},
    "paperTradingReady": {"const": true},
    "sandboxReady": {"const": true},
    "productionAdapterEnabled": {"const": false},
    "realPositionMutationAllowed": {"const": false},
    "orderCreateAllowed": {"const": false},
    "canCreateOrder": {"const": false},
    "formalTradingUnlocked": {"const": false},
    "autoTradeUnlocked": {"const": false},
    "intents": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "intentId", "generatedAt", "source", "executionMode", "strategyId", "draftStatus", "currentWeightPercent", "researchTargetWeightPercent", "formalTargetWeightPercent", "notionalAmount", "suggestedActionTypes", "canCreateOrder", "orderCreateAllowed", "formalTradingUnlocked", "autoTradeUnlocked", "blockedReasons", "evidenceRefs", "notTradingAdvice"], "properties": {
      "schemaVersion": {"const": "portfolio.paper_order_intent.v1"}, "intentId": {"type": "string", "minLength": 1}, "generatedAt": {"type": "string", "format": "date-time"}, "source": {"const": "manual_plan_draft"}, "executionMode": {"enum": ["paper", "sandbox"]}, "strategyId": {"type": "string", "minLength": 1}, "draftStatus": {"const": "blocked"}, "currentWeightPercent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "researchTargetWeightPercent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "formalTargetWeightPercent": {"const": 0}, "notionalAmount": {"type": "null"}, "suggestedActionTypes": {"type": "array", "items": {"enum": ["RESEARCH", "OBSERVE", "COMPARE", "ALERT", "PLAN_DRAFT", "MANUAL_TRADE_DRAFT"]}, "uniqueItems": true}, "canCreateOrder": {"const": false}, "orderCreateAllowed": {"const": false}, "formalTradingUnlocked": {"const": false}, "autoTradeUnlocked": {"const": false}, "blockedReasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "notTradingAdvice": {"const": true}
    }}},
    "blockers": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}, "contains": {"const": "production_order_adapter_not_enabled"}},
    "warnings": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "protectedAccountDigestBefore": {"$ref": "#/$defs/accountDigest"},
    "protectedAccountDigestAfter": {"$ref": "#/$defs/accountDigest"},
    "accountFactsUnchanged": {"const": true},
    "notTradingAdvice": {"const": true}
  },
  "$defs": {
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "accountDigest": {"type": "object", "additionalProperties": false, "required": ["positionCount", "openPositionCount", "positionHash", "transactionCount", "transactionHash", "draftCount", "draftHash", "externalOrderCount", "externalOrderHash"], "properties": {"positionCount": {"type": "integer", "minimum": 0}, "openPositionCount": {"type": "integer", "minimum": 0}, "positionHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "transactionCount": {"type": "integer", "minimum": 0}, "transactionHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "draftCount": {"type": "integer", "minimum": 0}, "draftHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "externalOrderCount": {"type": "integer", "minimum": 0}, "externalOrderHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
  }
}
