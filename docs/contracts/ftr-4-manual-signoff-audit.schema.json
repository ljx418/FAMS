{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fams.local/schemas/ftr-4-manual-signoff-audit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "currentManifestHash", "status", "chainValid", "appendOnly", "automationSelfApprovalBlocked", "requiredRoles", "records", "recordCount", "allRequiredSignedOff", "manualSignoffPassed", "blockers", "formalTradingUnlocked", "autoTradeUnlocked", "canCreateOrder", "orderCreateAllowed"],
  "properties": {
    "schemaVersion": {"const": "fams.formal_release.manual_signoff_audit.v1"},
    "operationId": {"type": "string", "pattern": "^ftr4-review-[a-f0-9]{16}$"},
    "currentManifestHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "missing"},
    "chainValid": {"const": true},
    "appendOnly": {"const": true},
    "automationSelfApprovalBlocked": {"const": true},
    "requiredRoles": {"const": ["data", "model", "risk", "compliance", "final_release"]},
    "records": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["role", "status", "decision", "reviewerUserId", "reviewerEmail", "reviewedAt", "notes", "manifestHash", "artifactCurrent", "recordHash", "blockers"], "properties": {
      "role": {"enum": ["data", "model", "risk", "compliance", "final_release"]}, "status": {"const": "missing"}, "decision": {"type": "null"}, "reviewerUserId": {"type": "null"}, "reviewerEmail": {"type": "null"}, "reviewedAt": {"type": "null"}, "notes": {"type": "null"}, "manifestHash": {"type": "null"}, "artifactCurrent": {"type": "boolean"}, "recordHash": {"type": "null"}, "blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "_signoff_missing$"}
    }}}},
    "recordCount": {"const": 0},
    "allRequiredSignedOff": {"const": false},
    "manualSignoffPassed": {"const": false},
    "blockers": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "_signoff_missing$"}},
    "formalTradingUnlocked": {"const": false},
    "autoTradeUnlocked": {"const": false},
    "canCreateOrder": {"const": false},
    "orderCreateAllowed": {"const": false}
  }
}
