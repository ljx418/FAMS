{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fams.local/schemas/ftr-1-field-evidence-validation-audit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "candidateCount", "items", "candidateResults", "blockers", "criticalFieldsHaveEvidenceRefs", "noCriticalProviderUnknown", "noCriticalFreshnessUnknownOrStale", "noCriticalCoverageBlocked", "researchFallbackPromotedToFormal", "formalTradingUnlocked", "autoTradeUnlocked", "canCreateOrder", "orderCreateAllowed"],
  "properties": {
    "schemaVersion": {"const": "fams.formal_data.field_evidence_validation_collection.v2"},
    "status": {"const": "passed"},
    "candidateCount": {"const": 7},
    "items": {
      "type": "array",
      "minItems": 49,
      "maxItems": 49,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateStrategyId", "candidateStrategyVersion", "fieldId", "critical", "applicability", "providerId", "providerClass", "sourceEndpoint", "asOfDate", "fetchedAt", "coveragePercent", "crossCheckStatus", "evidenceRefs", "evidenceHash", "warnings", "inputBlockers", "freshnessStatus", "blockers", "status"],
        "properties": {
          "candidateStrategyId": {"enum": ["local_real_data_sample_60_40", "local_real_data_equal_weight_5", "local_real_data_concentrated_3", "dividend_low_vol_basket", "permanent_portfolio", "all_weather", "current_holdings_buy_and_hold"]},
          "candidateStrategyVersion": {"type": "string", "minLength": 1},
          "fieldId": {"enum": ["price", "benchmark", "dividend", "tradeability", "fundamental", "industryClassification", "costModel"]},
          "critical": {"type": "boolean"},
          "applicability": {"enum": ["required", "not_applicable"]},
          "notApplicableReason": {"type": ["string", "null"]},
          "providerId": {"type": "string", "minLength": 1},
          "providerClass": {"enum": ["official", "authorized_commercial", "trusted_internal", "trusted_public_noncommercial"]},
          "sourceEndpoint": {"type": "string", "minLength": 1},
          "asOfDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "fetchedAt": {"type": "string", "format": "date-time"},
          "coveragePercent": {"type": "number", "minimum": 80, "maximum": 100},
          "crossCheckStatus": {"enum": ["official_verified", "trusted_cross_checked", "immutable_replay_verified", "not_applicable"]},
          "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidenceHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "inputBlockers": {"type": "array", "maxItems": 0},
          "freshnessStatus": {"enum": ["fresh", "frozen_historical"]},
          "blockers": {"type": "array", "maxItems": 0},
          "status": {"const": "passed"}
          ,"temporalScope": {"enum": ["current_state", "frozen_historical_window"]}
        }
      }
    },
    "candidateResults": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateStrategyId", "candidateStrategyVersion", "status", "snapshotHash", "persistedSnapshotId", "blockers"],
        "properties": {
          "candidateStrategyId": {"enum": ["local_real_data_sample_60_40", "local_real_data_equal_weight_5", "local_real_data_concentrated_3", "dividend_low_vol_basket", "permanent_portfolio", "all_weather", "current_holdings_buy_and_hold"]},
          "candidateStrategyVersion": {"type": "string", "minLength": 1},
          "status": {"const": "passed"},
          "snapshotHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "persistedSnapshotId": {"type": "string", "minLength": 1},
          "blockers": {"type": "array", "maxItems": 0}
        }
      }
    },
    "blockers": {"type": "array", "maxItems": 0},
    "criticalFieldsHaveEvidenceRefs": {"const": true},
    "noCriticalProviderUnknown": {"const": true},
    "noCriticalFreshnessUnknownOrStale": {"const": true},
    "noCriticalCoverageBlocked": {"const": true},
    "researchFallbackPromotedToFormal": {"const": false},
    "formalTradingUnlocked": {"const": false},
    "autoTradeUnlocked": {"const": false},
    "canCreateOrder": {"const": false},
    "orderCreateAllowed": {"const": false}
  }
}
