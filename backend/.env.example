# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"
# Optional absolute path override for WSL/DrvFS deployments where differently-cased
# workspace aliases can break SQLite WAL/SHM locking.
# FAMS_SQLITE_DATABASE_PATH="/mnt/c/workspace/financial-asset-manager/backend/prisma/dev.db"
FAMS_SQLITE_CONNECTION_LIMIT=4

# Redis (Optional)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-key-change-in-production"

# Log
LOG_LEVEL=info

# LLM keys. Copy this file to backend/.env and fill real secrets locally.
# Do not commit backend/.env. Do not put real keys in frontend env files.
#
# Generic LLM configuration. Recommended first choice:
#   FAMS_LLM_PROVIDER=openai
#   FAMS_LLM_API_KEY=<your-llm-key>
#   FAMS_LLM_MODEL=gpt-4o-mini
FAMS_LLM_PROVIDER=openai
FAMS_LLM_API_KEY=
FAMS_LLM_MODEL=gpt-4o-mini
FAMS_LLM_BASE_URL=https://api.openai.com/v1
FAMS_LLM_TIMEOUT_MS=30000

# ChatBox LLM switch.
# 0: keep deterministic planner with LLM key available for stock fact explanation.
# 1: expose ChatBox as LLM-assisted-planner-ready while executable actions still route through FAMS tool gate.
FAMS_CHAT_LLM_ENABLED=0

# Optional screenshot vision extraction. The ChatBox asks for explicit per-upload consent.
# If unset, screenshots can still be private-saved and Codex can submit structured extraction rows through MCP.
FAMS_VISION_MODEL=
FAMS_VISION_API_KEY=
FAMS_VISION_BASE_URL=
FAMS_VISION_TIMEOUT_MS=60000

# Private screenshot storage (defaults to backend/data/private-captures).
# FAMS_CAPTURE_STORAGE_DIR=/absolute/private/path

# ChatBox is the primary review entry. Enable unattended weekday runs explicitly.
FAMS_DAILY_REVIEW_SCHEDULER_ENABLED=false
FAMS_DAILY_REVIEW_SCHEDULER_CRON="30 9,14 * * 1-5"
FAMS_DAILY_REVIEW_SCHEDULER_TIMEZONE=Asia/Shanghai
FAMS_DAILY_REVIEW_SCHEDULER_USER_ID=default
# cached uses existing local factsets; live allows the existing stock-analysis provider to refresh them.
FAMS_DAILY_REVIEW_EXTERNAL_ANALYSIS_MODE=cached
FAMS_DAILY_REVIEW_ASSET_TIMEOUT_MS=45000

# Compatible legacy provider variables. Use only one family at a time.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# Local service URLs
FAMS_API_BASE=http://127.0.0.1:4000
FAMS_INTERNAL_API_BASE=http://127.0.0.1:4000

# External APIs (Optional - for production)
# YAHOO_FINANCE_API_KEY=""
# EASTMONEY_API_KEY=""

# Production readiness gates
# Keep DATABASE_URL on SQLite until the explicit PostgreSQL migration is reviewed.
# Shadow PostgreSQL is used only for staging/smoke/pressure verification.
# FAMS_POSTGRES_SHADOW_DATABASE_URL="postgresql://fams_shadow:change-me@127.0.0.1:5432/fams_shadow"
# FAMS_POSTGRES_SHADOW_TIMEOUT_MS=5000
# FAMS_POSTGRES_SHADOW_STATEMENT_TIMEOUT_MS=10000

# Optional formal A-share trading state provider.
# Free sources can produce analysis advice without this token; configure it for formal trading-state enhancement.
# FAMS_TUSHARE_TOKEN=""
# TUSHARE_TOKEN=""
# Optional dividend-low-vol formal provider ingestion controls.
# FAMS_DIVIDEND_LOW_VOL_PROVIDER_SYMBOLS="000001,600000"
# FAMS_DIVIDEND_LOW_VOL_PROVIDER_TRADE_DATE="20260605"
# FAMS_DIVIDEND_LOW_VOL_PROVIDER_PERIOD="20251231"
# Set to 1 to test contract/audit generation without calling Tushare.
# FAMS_DIVIDEND_LOW_VOL_PROVIDER_DRY_RUN=0

# Formal dividend-low-vol backtest promotion gates. Keep unset until the referenced datasets are genuinely ingested.
# FAMS_H30269_TOTAL_RETURN_BENCHMARK_READY=false
# FAMS_EX_DIVIDEND_TOTAL_RETURN_SERIES_READY=false
# FAMS_LIMIT_UP_DOWN_DAILY_STATE_READY=false
# FAMS_SUSPENSION_DAILY_STATE_READY=false

# Screener validation depth for full-A runs. Higher values are slower but reduce top-3 validation blind spots.
# FAMS_SCREENER_DEEP_VALIDATION_TOP_N=12

# CI/release gate. When set to 1, npm run test:production-readiness fails if analysis-advice readiness is red.
# FAMS_READINESS_STRICT=0
# Trade-action gate. When set to 1 or when using --strict-trade, readiness fails until validation evidence allows manual trade drafts.
# FAMS_TRADE_READINESS_STRICT=0
# FAMS_READINESS_SYMBOLS="000001,600000"
