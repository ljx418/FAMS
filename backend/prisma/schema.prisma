// 一天可产生开盘、尾盘及手动多次研究运行，不能复用每日唯一快照。
model DailyReviewRun {
  id                     String           @id @default(uuid())
  userId                 String
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationId            String?          @unique
  operation              Operation?       @relation(fields: [operationId], references: [id], onDelete: SetNull)
  adviceId               String?          @unique
  advice                 Advice?          @relation(fields: [adviceId], references: [id], onDelete: SetNull)
  previousRunId          String?
  previousRun            DailyReviewRun?  @relation("DailyReviewRunHistory", fields: [previousRunId], references: [id], onDelete: SetNull)
  nextRuns               DailyReviewRun[] @relation("DailyReviewRunHistory")
  sessionType            String
  triggerSource          String
  scheduledFor           DateTime?
  status                 String           @default("queued")
  generatedAt            DateTime         @default(now())
  completedAt            DateTime?
  strategyVersionIdsJson String           @default("[]")
  reportJson             String           @default("{}")
  dataQualityJson        String           @default("{}")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  positionSnapshots PositionSnapshot[]
  marketSnapshots   MarketSnapshot[]
  gridPlans         GridPlan[]

  @@index([userId, generatedAt])
  @@index([userId, sessionType, status, generatedAt])
  @@index([previousRunId])
}

// 人工交易计划草案；没有券商执行状态，也不会创建真实订单。
model GridPlan {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyReviewRunId  String
  dailyReviewRun    DailyReviewRun   @relation(fields: [dailyReviewRunId], references: [id], onDelete: Cascade)
