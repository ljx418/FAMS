  asset             Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  strategyVersionId String?
  strategyVersion   StrategyVersion? @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  previousPlanId    String?
  previousPlan      GridPlan?        @relation("GridPlanHistory", fields: [previousPlanId], references: [id], onDelete: SetNull)
  nextPlans         GridPlan[]       @relation("GridPlanHistory")
  mode              String
  status            String           @default("draft")
  summary           String?
  constraintsJson   String           @default("{}")
  changeReasonsJson String           @default("[]")
  evidenceRefsJson  String           @default("[]")
  validUntil        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  orders GridOrderDraft[]

  @@index([userId, assetId, createdAt])
  @@index([dailyReviewRunId])
  @@index([strategyVersionId])
  @@index([previousPlanId])
}

