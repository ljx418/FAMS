generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户
model User {
  id                        String                     @id @default(uuid())
  email                     String                     @unique
  passwordHash              String
  name                      String
  riskLevel                 Int                        @default(3) // 1-5 风险等级
  settings                  String                     @default("{}") // JSON设置
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  positions                 Position[]
  transactions              Transaction[]
  portfolios                Portfolio[]
  alerts                    Alert[]
  snapshots                 DailySnapshot[]
  advices                   Advice[]
  adviceInputSnapshots      AdviceInputSnapshot[]
  positionSnapshots         PositionSnapshot[]
  alertRules                AlertRule[]
  alertEvents               AlertEvent[]
  operations                Operation[]
  dailyReviewRuns           DailyReviewRun[]
  gridPlans                 GridPlan[]
  screenshotCaptures        ScreenshotCapture[]
  externalOrderObservations ExternalOrderObservation[]
  positionSleeveAllocations PositionSleeveAllocation[]
  positionSleeveLedgerEntries PositionSleeveLedgerEntry[]
  volatilityStrategyBacktests VolatilityStrategyBacktest[]
  volatilityTradeDrafts VolatilityTradeDraft[]
  relativeRotationWatchlistItems RelativeRotationWatchlistItem[]
}

// 资产主表
model Asset {
  id          String    @id @default(uuid())
  symbol      String    @unique // 代码：AAPL, 600519.SS
  name        String // 名称
  type        String // stock, fund, bond, gold, cash, crypto, etf, reit
  currency    String    @default("CNY")
  exchange    String? // 交易所：SH, SZ, HK, US
  sector      String? // 行业
  industry    String? // 细分行业
  riskLevel   Int? // 1-5
  lastPrice   Float?
  lastUpdated DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  positions                 Position[]
  transactions              Transaction[]
  priceHistory              PriceHistory[]
  assetTags                 AssetTag[]
  adviceActions             AdviceAction[]
  marketSnapshots           MarketSnapshot[]
  positionSnapshots         PositionSnapshot[]
  alertRules                AlertRule[]
  alertEvents               AlertEvent[]
  gridPlans                 GridPlan[]
  screenshotCaptureRows     ScreenshotCaptureRow[]
  externalOrderObservations ExternalOrderObservation[]
}

// 仓位
model Position {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  quantity      Float // 数量
  avgCost       Float // 平均成本
  currentPrice  Float? // 当前价格
  marketValue   Float? // 市值
  costBasis     Float? // 成本
  unrealizedPnl Float? // 浮动盈亏
  realizedPnl   Float     @default(0) // 已实现盈亏
  positionType  String    @default("long") // long, short
  status        String    @default("open") // open, closed, pending
  stopLoss      Float? // 止损收益率阈值（百分比，如 -5 表示亏损 5%）
  takeProfit    Float? // 止盈收益率阈值（百分比，如 5 表示盈利 5%）
  tags          String    @default("[]") // JSON数组
  labels        String    @default("[]") // JSON数组
  notes         String?
  source        String? // manual, import
  openKey       String?   @unique // open position uniqueness key: userId:assetId, null for closed positions
  openedAt      DateTime  @default(now())
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transactions Transaction[]
  snapshots    PositionSnapshot[]
  sleeveAllocation PositionSleeveAllocation?
  sleeveLedgerEntries PositionSleeveLedgerEntry[]
  volatilityBacktests VolatilityStrategyBacktest[]
  volatilityTradeDrafts VolatilityTradeDraft[]
}

// 交易记录
model Transaction {
  id                 String                @id @default(uuid())
  positionId         String?
  position           Position?             @relation(fields: [positionId], references: [id], onDelete: SetNull)
  userId             String
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId            String
  asset              Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type               String // buy, sell, dividend, split, transfer, fee
  quantity           Float
  price              Float
  fee                Float                 @default(0)
  amount             Float
  broker             String?
  confirmationNo     String?
  status             String                @default("confirmed") // pending, confirmed, cancelled
  executedAt         DateTime
  notes              String?
  source             String? // manual, imported, advice_confirmed
  adviceActionId     String?
  adviceAction       AdviceAction?         @relation(fields: [adviceActionId], references: [id], onDelete: SetNull)
  sourceImportKey    String?               @unique
  sourceCaptureRowId String?               @unique
  sourceCaptureRow   ScreenshotCaptureRow? @relation(fields: [sourceCaptureRowId], references: [id], onDelete: SetNull)
  sleeveType     String?  // core, volatility; required for buy/sell after sleeve activation
  volatilityTradeDraftId String? @unique
  volatilityTradeDraft VolatilityTradeDraft? @relation(fields: [volatilityTradeDraftId], references: [id], onDelete: SetNull)
  sleeveLedgerEntry PositionSleeveLedgerEntry?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([userId, executedAt])
  @@index([assetId, executedAt])
}

// 建议批次
model Advice {
  id                    String               @id @default(uuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  adviceInputSnapshotId String?
  adviceInputSnapshot   AdviceInputSnapshot? @relation(fields: [adviceInputSnapshotId], references: [id], onDelete: SetNull)
  generatedAt           DateTime             @default(now())
  schemaVersion         String               @default("v1")
  summaryText           String?
  disclaimerText        String?
  inputSnapshotJson     String               @default("{}")
  recommendationJson    String               @default("{}")
  rationaleText         String?
  riskLevel             String               @default("medium")
  status                String               @default("proposed") // proposed, accepted, rejected, partially_executed, expired
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  actions        AdviceAction[]
  dailyReviewRun DailyReviewRun?

  @@index([userId, generatedAt])
  @@index([adviceInputSnapshotId])
}

// 建议动作
model AdviceAction {
  id                String    @id @default(uuid())
  adviceId          String
  advice            Advice    @relation(fields: [adviceId], references: [id], onDelete: Cascade)
  assetId           String?
  asset             Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  actionType        String // buy, sell, hold, rebalance, grid_order, dca
  suggestedQuantity Float?
  suggestedAmount   Float?
  suggestedPrice    Float?
  targetPositionPct Float?
  confidence        Float?
  reason            String?
  status            String    @default("proposed") // proposed, accepted, rejected, executed, skipped
  executedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  transactions Transaction[]
  execution    AdviceExecution?

  @@index([adviceId])
  @@index([assetId])
}

model AdviceExecution {
  id             String       @id @default(uuid())
  adviceActionId String       @unique
  adviceAction   AdviceAction @relation(fields: [adviceActionId], references: [id], onDelete: Cascade)
  decision       String // accepted, rejected, modified, expired
  overrideJson   String       @default("{}")
  executedAt     DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AdviceInputSnapshot {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  capturedAt            DateTime @default(now())
  portfolioSnapshotJson String   @default("{}")
  positionSnapshotJson  String   @default("[]")
  marketSnapshotJson    String   @default("[]")
  constraintsJson       String   @default("{}")
  promptVersion         String?
  createdAt             DateTime @default(now())

  advices Advice[]

  @@index([userId, capturedAt])
}

model PositionSnapshot {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  positionId       String
  position         Position           @relation(fields: [positionId], references: [id], onDelete: Cascade)
  assetId          String
  asset            Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  capturedAt       DateTime           @default(now())
  quantity         Float
  avgCost          Float
  currentPrice     Float?
  marketValue      Float?
  costBasis        Float?
  actualWeightPct  Float?
  costWeightPct    Float?
  createdAt        DateTime           @default(now())
  dailyReviewRunId String?
  dailyReviewRun   DailyReviewRun?    @relation(fields: [dailyReviewRunId], references: [id], onDelete: SetNull)
  sourceCaptureId  String?
  sourceCapture    ScreenshotCapture? @relation(fields: [sourceCaptureId], references: [id], onDelete: SetNull)

  @@index([userId, capturedAt])
  @@index([positionId, capturedAt])
  @@index([assetId, capturedAt])
  @@index([dailyReviewRunId, capturedAt])
  @@index([sourceCaptureId, capturedAt])
}

model MarketSnapshot {
  id               String          @id @default(uuid())
  assetId          String
  asset            Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  capturedAt       DateTime        @default(now())
  price            Float?
  currency         String?
  source           String?
  confidenceScore  Float?          @default(0)
  dayChangePct     Float?
  valuationJson    String          @default("{}")
  technicalJson    String          @default("{}")
  createdAt        DateTime        @default(now())
  dailyReviewRunId String?
  dailyReviewRun   DailyReviewRun? @relation(fields: [dailyReviewRunId], references: [id], onDelete: SetNull)

  alertEvents AlertEvent[]

  @@index([assetId, capturedAt])
  @@index([dailyReviewRunId, capturedAt])
}

// 价格历史（时序数据）
model PriceHistory {
  id         String   @id @default(uuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  timestamp  DateTime
  openPrice  Float?
  highPrice  Float?
  lowPrice   Float?
  closePrice Float
  volume     Float?
  source     String? // yahoo, eastmoney, sina
  isValid    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([assetId, timestamp])
}

// 标签
model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("#5a6bff")
  category  String? // 地域：港股、美股；行业：科技；概念：新能源
  createdAt DateTime @default(now())

  assetTags AssetTag[]
}

// 资产-标签关联
model AssetTag {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([assetId, tagId])
}

// 投资组合
model Portfolio {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String // 永久组合、全天候组合
  type        String // permanent, all_weather, custom
  description String?
  config      String   @default("{}") // JSON配置
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  allocations PortfolioAllocation[]
}

// 组合配置
model PortfolioAllocation {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  assetType   String? // stock, bond, gold, cash
  tagId       String? // 标签
  targetRatio Float // 目标比例
  minRatio    Float? // 最小比例
  maxRatio    Float? // 最大比例
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 策略
model Strategy {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  type        String // momentum, mean_reversion, trend_following, custom
  parameters  String   @default("{}") // JSON参数
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  backtests Backtest[]
  versions  StrategyVersion[]
}

model StrategyVersion {
  id                 String    @id @default(uuid())
  strategyId         String
  strategy           Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  strategyKey        String
  schemaVersion      String
  signalStrategyId   String
  signalVersion      String
  thresholdHash      String
  entryPolicyId      String
  entryPolicyVersion String
  exitPolicyId       String
  exitPolicyVersion  String
  holdingDays        Int?
  sizingPolicyId     String
  sizingVersion      String
  portfolioPolicyId  String
  portfolioVersion   String
  costModelId        String
  costModelVersion   String
  constraintId       String
  constraintVersion  String
  engineVersion      String
  versionBundleJson  String    @default("{}")
  auditHash          String
  isActive           Boolean   @default(true)
  validationJson     String    @default("{}")
  validatedAt        DateTime?
  activatedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  gridPlans GridPlan[]

  @@unique([strategyId, auditHash])
  @@index([strategyKey, auditHash])
  @@index([signalStrategyId, signalVersion])
}

// 回测
model Backtest {
  id               String    @id @default(uuid())
  strategyId       String
  strategy         Strategy  @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  name             String?
  startDate        DateTime
  endDate          DateTime
  initialCapital   Float
  finalCapital     Float?
  totalReturn      Float?
  annualizedReturn Float?
  maxDrawdown      Float?
  sharpeRatio      Float?
  winRate          Float?
  tradesCount      Int?
  status           String    @default("pending") // pending, running, completed, failed
  progress         Int       @default(0)
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  results BacktestResult[]
  signals TradeSignal[]
}

// 回测结果
model BacktestResult {
  id               String   @id @default(uuid())
  backtestId       String
  backtest         Backtest @relation(fields: [backtestId], references: [id], onDelete: Cascade)
  periodStart      DateTime
  periodEnd        DateTime
  totalReturn      Float?
  annualizedReturn Float?
  maxDrawdown      Float?
  sharpeRatio      Float?
  winRate          Float?
  profitFactor     Float?
  tradesCount      Int?
  equityCurve      String   @default("[]") // JSON数组
  monthlyReturns   String   @default("[]") // JSON数组
  reviewReportJson String   @default("{}")
  createdAt        DateTime @default(now())
}

// 交易信号
model TradeSignal {
  id          String    @id @default(uuid())
  backtestId  String?
  backtest    Backtest? @relation(fields: [backtestId], references: [id], onDelete: SetNull)
  assetSymbol String
  signalType  String // buy, sell, hold
  action      String // buy, sell, maintain
  quantity    Float?
  price       Float?
  confidence  Int // 0-100
  reason      String?
  executed    Boolean   @default(false)
  executedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// 每日快照
model DailySnapshot {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime
  totalValue     Float
  cashBalance    Float
  positionsCount Int
  topGainers     String   @default("[]") // JSON
  topLosers      String   @default("[]") // JSON
  allocation     String   @default("{}") // JSON
  pnlDay         Float?
  pnlPercent     Float?
  createdAt      DateTime @default(now())

  @@unique([userId, date])
}

// 告警
model Alert {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // price, risk, rebalance
  title          String
  message        String
  severity       String // info, warning, danger
  status         String    @default("active") // active, acknowledged, resolved
  assetSymbol    String?
  triggeredAt    DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())
}

model AlertRule {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId              String?
  asset                Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  ruleType             String // price_above, price_below, position_deviation, drawdown, valuation_percentile
  thresholdValue       Float?
  comparisonConfigJson String    @default("{}")
  enabled              Boolean   @default(true)
  lastTriggeredAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  events AlertEvent[]

  @@index([userId, ruleType])
  @@index([assetId, ruleType])
}

model AlertEvent {
  id               String          @id @default(uuid())
  alertRuleId      String
  alertRule        AlertRule       @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetId          String?
  asset            Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  operationId      String?
  operation        Operation?      @relation(fields: [operationId], references: [id], onDelete: SetNull)
  marketSnapshotId String?
  marketSnapshot   MarketSnapshot? @relation(fields: [marketSnapshotId], references: [id], onDelete: SetNull)
  message          String
  severity         String // info, warning, danger
  status           String          @default("unread") // unread, read, dismissed
  triggeredAt      DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@index([userId, status, triggeredAt])
  @@index([assetId, triggeredAt])
}

// 投资建议
model Suggestion {
  id        String   @id @default(uuid())
  userId    String
  period    String // daily, weekly
  date      DateTime
  content   String // JSON内容
  createdAt DateTime @default(now())

  @@index([userId, period, date])
}

model Operation {
  id                String     @id @default(uuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentOperationId String?
  parentOperation   Operation? @relation("OperationToChildren", fields: [parentOperationId], references: [id], onDelete: SetNull)
  type              String // refresh_prices, check_alerts, generate_daily_advice, run_backtest, generate_backtest_report
  status            String     @default("queued") // queued, running, completed/succeeded, failed, cancelling, cancelled, partial
  requestedAt       DateTime   @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  progressPct       Int        @default(0)
  progressCurrent   Int?
  progressTotal     Int?
  progressMessage   String?
  cancelRequested   Boolean    @default(false)
  createdBy         String     @default("user") // user, scheduler, system, agent
  idempotencyKey    String?
  leaseOwner        String?
  leaseToken        String?
  leaseExpiresAt    DateTime?
  heartbeatAt       DateTime?
  inputJson         String     @default("{}")
  resultJson        String     @default("{}")
  errorJson         String     @default("{}")
  errorSummary      String?
  recoveryJson      String     @default("{}")
  artifactRefsJson  String     @default("[]")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  alertEvents     AlertEvent[]
  childOperations Operation[]     @relation("OperationToChildren")
  tasks           OperationTask[]
  dailyReviewRun  DailyReviewRun?

  @@unique([type, idempotencyKey])
  @@index([userId, type, status])
  @@index([status, requestedAt])
  @@index([type, status, leaseExpiresAt])
  @@index([leaseOwner, leaseToken])
  @@index([parentOperationId, type, requestedAt])
}

model OperationTask {
  id             String    @id @default(uuid())
  operationId    String
  operation      Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  name           String
  taskType       String?
  chunkIndex     Int?
  status         String    @default("queued") // queued, running, completed/succeeded, failed, cancelling, cancelled, partial
  attempt        Int       @default(1)
  maxAttempts    Int       @default(3)
  idempotencyKey String?
  inputJson      String    @default("{}")
  outputJson     String    @default("{}")
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  successCount   Int       @default(0)
  failureCount   Int       @default(0)
  provider       String?
  cacheHitRate   Float?
  warningsJson   String    @default("[]")
  metricsJson    String    @default("{}")
  errorJson      String    @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([operationId, idempotencyKey])
  @@index([operationId, name, chunkIndex])
  @@index([operationId, status])
}

model SchedulerLease {
  name           String    @id
  leaseOwner     String?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  lastRunAt      DateTime?
  lastResultJson String    @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([leaseExpiresAt])
}

// 同一真实持仓内部的核心仓 / 波动仓当前状态。Position 仍是真实总仓位来源。
model PositionSleeveAllocation {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  positionId             String   @unique
  position               Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  status                 String   @default("active") // proposed, active, paused, closed
  coreQuantity           Float
  volatilityQuantity     Float
  volatilityCash         Float    @default(0)
  volatilityCostBasis    Float    @default(0)
  volatilityRealizedPnl  Float    @default(0)
  recommendedRatio       Float?
  confirmedRatio         Float
  strategyProfile        String   @default("conservative") // conservative, strict
  strategyVersion        String   @default("volatility_swing.v1")
  sourceBacktestId       String?
  version                Int      @default(1)
  activatedAt            DateTime @default(now())
  closedAt               DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  ledgerEntries PositionSleeveLedgerEntry[]
  tradeDrafts   VolatilityTradeDraft[]

  @@index([userId, status])
  @@index([positionId, status])
}

// 分仓不可变台账；交易归属、跨仓划转和波动现金变化均写入这里。
model PositionSleeveLedgerEntry {
  id                String   @id @default(uuid())
  allocationId      String
  allocation        PositionSleeveAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  positionId        String
  position          Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  transactionId     String?  @unique
  transaction       Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  entryType         String   // activate, buy, sell, security_transfer, cash_transfer, adjustment, close
  sleeveType        String   // core, volatility
  quantityDelta     Float    @default(0)
  cashDelta         Float    @default(0)
  costBasisDelta    Float    @default(0)
  realizedPnlDelta  Float    @default(0)
  price             Float?
  fee               Float    @default(0)
  notes             String?
  metadataJson      String   @default("{}")
  occurredAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([allocationId, occurredAt])
  @@index([userId, positionId, occurredAt])
}

// 透明相对轮动坐标，不使用专有 JdK 字段命名。
model RelativeRotationPoint {
  id                    String   @id @default(uuid())
  symbol                String
  benchmarkId           String
  frequency             String   @default("weekly")
  tradeDate             DateTime
  relativePrice         Float
  relativeTrend         Float
  relativeMomentum      Float
  quadrant              String
  deltaX                Float?
  deltaY                Float?
  speed                 Float?
  adjustType            String   @default("qfq")
  formulaVersion        String   @default("transparent_relative_rotation.v1")
  dataVersion           String   @default("relative_rotation.v1")
  dataStatus            String   @default("ready") // ready, partial, insufficient, stale
  coveragePercent       Float    @default(0)
  evidenceRefsJson      String   @default("[]")
  computedAt            DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([symbol, benchmarkId, frequency, tradeDate, formulaVersion])
  @@index([symbol, benchmarkId, frequency, tradeDate])
  @@index([tradeDate, quadrant])
}

// 用户维护的 RRG 自选关系。显隐仅保存在前端，不进入该模型。
model RelativeRotationWatchlistItem {
  id                   String   @id @default(uuid())
  userId               String
